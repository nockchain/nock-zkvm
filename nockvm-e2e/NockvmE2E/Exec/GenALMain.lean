/-
  NockvmE2E/Exec/GenALMain.lean   (untrusted generator, no theorem)

  `nockvm-e2e-genal OUT`: writes `OUT/J9ALChips.lean` (the ALU verifier literal `chipAlu` = `verifierChipT` of the chip the DAG of `aluSpec` parses to,
  with `aluDers`; the `J9AChipsGen.loadedOf` pipeline) and `OUT/PrimToks.lean` (the token table of nock's `primC op`, codes 1..6).
  The outputs are copied into `Exec/` by hand; the kernel ties are `Exec/J9ALChipsK_alu.lean` (ALU) and `Exec/PrimToksTie.lean` (tokens).
-/
import NockvmE2E.Exec.J9AChipsGen
import NockvmE2E.Emit.ChipsJ9AL
import Nock.Jet.PrimJ9
import Lean.Data.Json

set_option autoImplicit false
set_option maxRecDepth 100000

namespace NockvmE2E.Exec.GenAL
open NockvmE2E.Exec NockvmE2E.Exec.Tr NockvmE2E.Exec.VC NockvmE2E.Exec.J9AChips NockvmE2E.Exec.J8Chips NockvmE2E.Emit Nock.Emit

def litAlu : Option Chip := (loadedOf "aluChipJ9" aluSpec).map fun c => (verifierChipT c aluDers jMeta).1

def toks : Nock.Jet.Prim.PrimOp → List String := fun op => go (Nock.Jet.Prim.primC op)
where go : Nock.Noun → List String
  | Nock.Noun.atom n => [s!".atom {n}"]
  | Nock.Noun.cell a b => ".cell" :: (go a ++ go b)

def primsL : List (Nat × Nock.Jet.Prim.PrimOp) :=
  [(1, .add), (2, .sub), (3, .lt), (4, .mul), (5, .div), (6, .mod)]

def primToksSrc : String :=
  let rows := primsL.map fun (c, op) => s!"  ({c}, [{", ".intercalate (toks op)}])"
  "/-\n  NockvmE2E/Exec/PrimToks.lean   (generated by `nockvm-e2e-genal`; executed, Mathlib-free data)\n\n" ++
  "  `primToks code`: the token list of the primitive formula noun `primC op` (nock `Nock.Jet.Prim.primC`, `code = RealIOJ9AL.primCode op`:\n" ++
  "  `add 1, sub 2, lt 3, mul 4, div 5, mod 6`).  The verifier re-encodes the primitive claim records `pinRecsPE` from them.\n" ++
  "  Kernel tie to `primC`: `Exec/PrimToksTie.lean`.\n-/\nimport NockvmE2E.Exec.PubExe\nset_option autoImplicit false\n\n" ++
  "namespace NockvmE2E.Exec.PE\n\ndef primToksTable : List (Nat × List Tok) := [\n" ++ ",\n".intercalate rows ++ "]\n\n" ++
  "def primToks (code : Nat) : Option (List Tok) := (primToksTable.find? (·.1 == code)).map (·.2)\n\nend NockvmE2E.Exec.PE\n"

def aluSrc : String :=
  match litAlu with
  | none => "-- gen failed\n"
  | some c =>
    "/-\n  NockvmE2E/Exec/J9ALChips.lean   (generated by `nockvm-e2e-genal`)\n\n" ++
    "  The expected VERIFIER chip `chipAlu` of the J-9 AL ALU `aluChipJ9` (width 196; `verifierChipT` with `aluDers` = `jDers ++ yDers`).\n" ++
    "  Mathlib-free, total.  Kernel tie: `Exec/J9ALChipsK_alu.lean`.\n-/\nimport NockvmE2E.Exec.J8Chips\nset_option autoImplicit false\n" ++
    "set_option maxRecDepth 100000\n\nnamespace NockvmE2E.Exec.J9ALChips\nopen NockvmE2E.Exec NockvmE2E.Exec.Tr NockvmE2E.Exec.VC\n\n" ++
    renderChip "chipAlu" c ++ "\nend NockvmE2E.Exec.J9ALChips\n"

def main (args : List String) : IO UInt32 := do
  let out := args.headD "out"
  IO.FS.createDirAll out
  IO.FS.writeFile (out ++ "/PrimToks.lean") primToksSrc
  IO.FS.writeFile (out ++ "/J9ALChips.lean") aluSrc
  IO.println s!"wrote {out}/PrimToks.lean, {out}/J9ALChips.lean; alu cons {(litAlu.map (·.cons.size)).getD 0} shared {(litAlu.map (·.shared.size)).getD 0}"
  pure 0

end NockvmE2E.Exec.GenAL

def main (args : List String) : IO UInt32 := NockvmE2E.Exec.GenAL.main args
