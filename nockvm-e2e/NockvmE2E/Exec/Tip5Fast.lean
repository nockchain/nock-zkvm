/-
  NockvmE2E/Exec/Tip5Fast.lean   (GENERATED by scratchpad/genfast2.py, then hand-checked)
  Fast compiled Tip5 (Mathlib-free).  Every function below is proved EQUAL, over ALL inputs (lists of any length, any Nat entries,
  NO precondition), to its `Tip5Core` original, and the equality is registered `@[csimp]`, so code compiled in a module that
  imports this file calls the fast version.  No `native_decide`, no `implemented_by`, no `extern`, no Mathlib.
  Fast form: the 16-lane state is a structure of 16 unboxed `UInt64`; Goldilocks product by 32-bit limbs (`mul128`, `reduce128`,
  `mulU`), `pow7U`, byte lookup `lkU`, MDS rows unrolled with literal coefficients, each sbox lane split `t = hi*2^32 + lo` so the
  16 products per row are small, one `laneU` reduction per lane.  If the input list does not have 16 entries all `< 2^64` the
  ORIGINAL slow function is used (so the equality needs no precondition).
-/
import NockvmE2E.Exec.Tip5Core
set_option autoImplicit false
set_option maxRecDepth 100000

namespace NockvmE2E.Exec.Tip5Fast
open NockvmE2E.Exec.Tip5Core

/-- Round constants times R, flat: index `16 * i + j`. -/
def rcA : Array Nat := ((List.range 112).map fun k => rcMont (k / 16) (k % 16)).toArray
theorem rcA_eq : ∀ i, i < 7 → ∀ j, j < 16 → rcMont i j = rcA.getD (16 * i + j) 0 := by
  have : ∀ i, i < 7 → ∀ j, j < 16 → rcMont i j = rcA.getD (16 * i + j) 0 := by decide +kernel
  exact this
theorem toUInt64_toNat (n : Nat) (h : n < 18446744073709551616) : n.toUInt64.toNat = n := by
  simp [Nat.toUInt64]; omega
theorem rcMont_lt (i j : Nat) : rcMont i j < 18446744073709551616 := by
  have : rcMont i j < P := Nat.mod_lt _ (by decide)
  have hP : P = 18446744069414584321 := rfl
  omega
theorem sr32 (x : UInt64) : (x >>> 32).toNat = x.toNat / 4294967296 := by
  simp [UInt64.toNat_shiftRight, Nat.shiftRight_eq_div_pow]
theorem and32 (x : UInt64) : (x &&& 4294967295).toNat = x.toNat % 4294967296 := by
  rw [UInt64.toNat_and]
  exact Nat.and_two_pow_sub_one_eq_mod x.toNat 32

/-- 128-bit product: `(hi, lo)` with `hi * 2^64 + lo = a * b`. -/
@[inline] def mul128 (a b : UInt64) : UInt64 × UInt64 :=
  let a0 := a &&& 4294967295
  let a1 := a >>> 32
  let b0 := b &&& 4294967295
  let b1 := b >>> 32
  let p00 := a0 * b0
  let p01 := a0 * b1
  let p10 := a1 * b0
  let p11 := a1 * b1
  let t := p01 + (p00 >>> 32)
  let u := p10 + (t &&& 4294967295)
  (p11 + (t >>> 32) + (u >>> 32), a * b)
theorem prod_lt (x y : Nat) (hx : x < 4294967296) (hy : y < 4294967296) : x * y ≤ 18446744065119617025 := by
  have := Nat.mul_le_mul (Nat.le_of_lt_succ hx) (Nat.le_of_lt_succ hy)
  simpa using this
theorem mul128_spec (a b : UInt64) :
    (mul128 a b).1.toNat * 18446744073709551616 + (mul128 a b).2.toNat = a.toNat * b.toNat := by
  have ha := UInt64.toNat_lt a
  have hb := UInt64.toNat_lt b
  generalize hA : a.toNat = A at *
  generalize hB : b.toNat = B at *
  have e0 : (a &&& 4294967295).toNat = A % 4294967296 := by rw [and32, hA]
  have e1 : (a >>> 32).toNat = A / 4294967296 := by rw [sr32, hA]
  have f0 : (b &&& 4294967295).toNat = B % 4294967296 := by rw [and32, hB]
  have f1 : (b >>> 32).toNat = B / 4294967296 := by rw [sr32, hB]
  generalize hA0 : A % 4294967296 = A0 at e0
  generalize hA1 : A / 4294967296 = A1 at e1
  generalize hB0 : B % 4294967296 = B0 at f0
  generalize hB1 : B / 4294967296 = B1 at f1
  have hAs : A = A1 * 4294967296 + A0 := by omega
  have hBs : B = B1 * 4294967296 + B0 := by omega
  have lA0 : A0 < 4294967296 := by omega
  have lB0 : B0 < 4294967296 := by omega
  have lA1 : A1 < 4294967296 := by omega
  have lB1 : B1 < 4294967296 := by omega
  have q00 := prod_lt A0 B0 lA0 lB0
  have q01 := prod_lt A0 B1 lA0 lB1
  have q10 := prod_lt A1 B0 lA1 lB0
  have q11 := prod_lt A1 B1 lA1 lB1
  have hAB : A * B = (A1 * B1) * 18446744073709551616 + (A0 * B1 + A1 * B0) * 4294967296 + A0 * B0 := by
    have h : (18446744073709551616:Nat) = 4294967296 * 4294967296 := by decide
    rw [hAs, hBs, h]
    simp only [Nat.add_mul, Nat.mul_add]
    ac_rfl
  have hAB2 : A * B < 340282366920938463463374607431768211456 := by
    have := Nat.mul_lt_mul'' ha hb
    simpa using this
  simp only [mul128, UInt64.toNat_add, UInt64.toNat_mul, sr32, and32, e0, e1, f0, f1, hA, hB]
  generalize A0 * B0 = X00 at *
  generalize A0 * B1 = X01 at *
  generalize A1 * B0 = X10 at *
  generalize A1 * B1 = X11 at *
  generalize hAB' : A * B = AB at *
  omega

/-- `hi * 2^64 + lo` modulo `P`, as a (not nec. canonical) `UInt64` (Goldilocks: 2^64 = 2^32 - 1, 2^96 = -1). -/
@[inline] def reduce128 (hi lo : UInt64) : UInt64 :=
  let h1 := hi >>> 32
  let h0 := hi &&& 4294967295
  let t0 := if lo < h1 then lo - h1 - 4294967295 else lo - h1
  let t1 := h0 * 4294967295
  let r := t0 + t1
  if r < t1 then r + 4294967295 else r
theorem modeq_of (X R m : Nat) (h : X = R + m * 18446744069414584321) :
    R % 18446744069414584321 = X % 18446744069414584321 := by
  subst h; exact (Nat.add_mul_mod_self_right R m _).symm

/-- the arithmetic of `reduce128` on naturals (all four branches). -/
theorem red_nat (H1 H0 L X : Nat) (hX : X = H1 * 4294967296 + H0) (h1 : H1 < 4294967296) (h0 : H0 < 4294967296) (hL : L < 18446744073709551616) :
    (let t0 := if L < H1 then (18446744073709551616 - 4294967295 + (18446744073709551616 - H1 + L) % 18446744073709551616) % 18446744073709551616
               else (18446744073709551616 - H1 + L) % 18446744073709551616
     let t1 := H0 * 4294967295 % 18446744073709551616
     let r := (t0 + t1) % 18446744073709551616
     if r < t1 then (r + 4294967295) % 18446744073709551616 else r) % 18446744069414584321
    = (X * 18446744073709551616 + L) % 18446744069414584321 := by
  subst hX
  have t1v : H0 * 4294967295 % 18446744073709551616 = H0 * 4294967295 := by omega
  by_cases hb : L < H1
  · have t0v : (18446744073709551616 - 4294967295 + (18446744073709551616 - H1 + L) % 18446744073709551616) % 18446744073709551616 = L + 18446744069414584321 - H1 := by omega
    simp only [hb, ite_true, t0v, t1v]
    have hT0 : L + 18446744069414584321 - H1 < 18446744073709551616 := by omega
    generalize hT : L + 18446744069414584321 - H1 = T0 at *
    have hT1' : H0 * 4294967295 < 18446744073709551616 := by omega
    by_cases ho : (T0 + (H0 * 4294967295)) % 18446744073709551616 < (H0 * 4294967295)
    · rw [if_pos ho]
      have e1 : (T0 + (H0 * 4294967295)) % 18446744073709551616 = T0 + (H0 * 4294967295) - 18446744073709551616 := by omega
      rw [e1]
      have e2 : (T0 + (H0 * 4294967295) - 18446744073709551616 + 4294967295) % 18446744073709551616 = T0 + (H0 * 4294967295) - 18446744073709551616 + 4294967295 := by clear hT t0v; omega
      rw [e2]
      exact modeq_of _ _ (H1 * 4294967297 + H0) (by omega)
    · rw [if_neg ho]
      exact modeq_of _ _ (H1 * 4294967297 + H0 - 1) (by omega)
  · have t0v : (18446744073709551616 - H1 + L) % 18446744073709551616 = L - H1 := by omega
    simp only [hb, ite_false, t0v, t1v]
    have hT0 : L - H1 < 18446744073709551616 := by omega
    generalize hT : L - H1 = T0 at *
    have hT1' : H0 * 4294967295 < 18446744073709551616 := by omega
    by_cases ho : (T0 + (H0 * 4294967295)) % 18446744073709551616 < (H0 * 4294967295)
    · rw [if_pos ho]
      have e1 : (T0 + (H0 * 4294967295)) % 18446744073709551616 = T0 + (H0 * 4294967295) - 18446744073709551616 := by omega
      rw [e1]
      have e2 : (T0 + (H0 * 4294967295) - 18446744073709551616 + 4294967295) % 18446744073709551616 = T0 + (H0 * 4294967295) - 18446744073709551616 + 4294967295 := by clear hT t0v; omega
      rw [e2]
      exact modeq_of _ _ (H1 * 4294967297 + H0 + 1) (by omega)
    · rw [if_neg ho]
      exact modeq_of _ _ (H1 * 4294967297 + H0) (by omega)
theorem reduce128_spec (hi lo : UInt64) :
    (reduce128 hi lo).toNat % P = (hi.toNat * 18446744073709551616 + lo.toNat) % P := by
  have h1 := UInt64.toNat_lt hi
  have h2 := UInt64.toNat_lt lo
  have hP : P = 18446744069414584321 := rfl
  have key := red_nat (hi.toNat / 4294967296) (hi.toNat % 4294967296) lo.toNat hi.toNat (by omega)
    (by omega) (by omega) (by omega)
  dsimp only at key
  simp only [reduce128, hP]
  split <;> split <;>
  · rename_i hc1 hc2
    simp only [UInt64.lt_iff_toNat_lt, UInt64.toNat_add, UInt64.toNat_sub, UInt64.toNat_mul, sr32, and32,
      UInt64.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at hc1 hc2 ⊢
    simp only [hc1, hc2, ite_true, ite_false] at key
    exact key

/-- Goldilocks product, result `< 2^64` and congruent to `a * b` mod `P`. -/
@[inline] def mulU (a b : UInt64) : UInt64 :=
  let p := mul128 a b
  reduce128 p.1 p.2
theorem mulU_spec (a b : UInt64) : (mulU a b).toNat % P = a.toNat * b.toNat % P := by
  have h := mul128_spec a b
  rw [mulU, reduce128_spec, h]

/-- `x ^ 7` (not nec. canonical). -/
@[inline] def pow7U (x : UInt64) : UInt64 :=
  let x2 := mulU x x
  let x3 := mulU x2 x
  let x6 := mulU x3 x3
  mulU x6 x
theorem pow7_prod (n : Nat) : pow7 n % P = ((n * n) * (n * n) * (n * n) * n) % P := by
  unfold pow7
  simp only [Nat.mul_mod, Nat.mod_mod]

/-- congruence mod `P` (Mathlib-free `Nat.ModEq`). -/
def MEq (a b : Nat) : Prop := a % P = b % P
theorem MEq.trans {a b c : Nat} (h : MEq a b) (h' : MEq b c) : MEq a c := Eq.trans h h'
theorem MEq.symm {a b : Nat} (h : MEq a b) : MEq b a := Eq.symm h
theorem MEq.mul_right {a b : Nat} (c : Nat) (h : MEq a b) : MEq (a * c) (b * c) := by
  unfold MEq at *; rw [Nat.mul_mod, h, ← Nat.mul_mod]
theorem MEq.mul_left {a b : Nat} (c : Nat) (h : MEq a b) : MEq (c * a) (c * b) := by
  unfold MEq at *; rw [Nat.mul_mod, h, ← Nat.mul_mod]
theorem MEq.add {a b c d : Nat} (h : MEq a b) (h' : MEq c d) : MEq (a + c) (b + d) := by
  unfold MEq at *; rw [Nat.add_mod, h, h', ← Nat.add_mod]
theorem MEq.mul {a b c d : Nat} (h : MEq a b) (h' : MEq c d) : MEq (a * c) (b * d) := by
  unfold MEq at *; rw [Nat.mul_mod, h, h', ← Nat.mul_mod]
theorem pow7U_spec (x : UInt64) :
    (pow7U x).toNat % P = pow7 x.toNat % P := by
  rw [pow7_prod]
  have m2 := mulU_spec x x
  have m3 := mulU_spec (mulU x x) x
  have m6 := mulU_spec (mulU (mulU x x) x) (mulU (mulU x x) x)
  have m7 := mulU_spec (mulU (mulU (mulU x x) x) (mulU (mulU x x) x)) x
  show (mulU (mulU (mulU (mulU x x) x) (mulU (mulU x x) x)) x).toNat % P = _
  generalize x.toNat = X at *
  have e2 : MEq (mulU x x).toNat (X * X) := m2
  have e3 : MEq (mulU (mulU x x) x).toNat ((X * X) * X) := m3.trans (MEq.mul_right X e2)
  have e6 : MEq (mulU (mulU (mulU x x) x) (mulU (mulU x x) x)).toNat (((X * X) * X) * ((X * X) * X)) :=
    m6.trans (MEq.mul e3 e3)
  have e7 : MEq (mulU (mulU (mulU (mulU x x) x) (mulU (mulU x x) x)) x).toNat ((((X * X) * X) * ((X * X) * X)) * X) :=
    m7.trans (MEq.mul_right X e6)
  have : (((X * X) * X) * ((X * X) * X)) * X = (X * X) * (X * X) * (X * X) * X := by ac_rfl
  rw [this] at e7
  exact e7


/-! ### lookup lane on a `UInt64` -/
def tabA : Array Nat := lookupTable.toArray
theorem tabA_getD (i : Nat) : tabA.getD i 0 = lookupTable.getD i 0 := by
  simp [tabA, List.getD_eq_getElem?_getD]
theorem tab_lt (i : Nat) : tabA.getD i 0 < 256 := by
  rw [tabA_getD]
  by_cases h : i < 256
  · have : ∀ j, j < 256 → lookupTable.getD j 0 < 256 := by decide +kernel
    exact this i h
  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by rw [lookupTable_length]; omega)]
    simp
@[inline] def tw (w : UInt64) (k : UInt64) : UInt64 :=
  (tabA.getD ((w >>> k) &&& 255).toNat 0).toUInt64 <<< k
def lkU (w : UInt64) : UInt64 :=
  tw w 0 + tw w 8 + tw w 16 + tw w 24 + tw w 32 + tw w 40 + tw w 48 + tw w 56
theorem and255 (y : Nat) : y &&& 255 = y % 256 := Nat.and_two_pow_sub_one_eq_mod y 8
theorem idx_spec (w k : UInt64) (hk : k.toNat < 64) :
    ((w >>> k) &&& 255).toNat = w.toNat / 2 ^ k.toNat % 256 := by
  have c : (255 : UInt64).toNat = 255 := rfl
  rw [UInt64.toNat_and, UInt64.toNat_shiftRight, Nat.mod_eq_of_lt hk, c, and255, Nat.shiftRight_eq_div_pow]
theorem toUInt64_toNat_small (T : Nat) (h : T < 256) : T.toUInt64.toNat = T := by
  simp [Nat.toUInt64, UInt64.toNat_ofNat]; omega
theorem tw_spec (w : UInt64) (k : Nat) (hk : k < 64) (hk8 : k % 8 = 0) :
    (tw w k.toUInt64).toNat = lookupTable.getD (w.toNat / 2 ^ k % 256) 0 * 2 ^ k := by
  have hk' : k.toUInt64.toNat = k := by simp; omega
  have hi := idx_spec w k.toUInt64 (by omega)
  rw [hk'] at hi
  unfold tw
  rw [UInt64.toNat_shiftLeft, hi, toUInt64_toNat_small _ (tab_lt _), hk', Nat.mod_eq_of_lt hk, Nat.shiftLeft_eq, tabA_getD]
  have hl := tab_lt (w.toNat / 2 ^ k % 256)
  rw [tabA_getD] at hl
  generalize lookupTable.getD (w.toNat / 2 ^ k % 256) 0 = T at *
  have e : k = 0 ∨ k = 8 ∨ k = 16 ∨ k = 24 ∨ k = 32 ∨ k = 40 ∨ k = 48 ∨ k = 56 := by omega
  rcases e with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
theorem lk_unroll (x : Nat) : lookupLane x = 0 + lookupTable.getD ((x >>> (8*0)) &&& 255) 0 <<< (8*0) + lookupTable.getD ((x >>> (8*1)) &&& 255) 0 <<< (8*1) + lookupTable.getD ((x >>> (8*2)) &&& 255) 0 <<< (8*2) + lookupTable.getD ((x >>> (8*3)) &&& 255) 0 <<< (8*3) + lookupTable.getD ((x >>> (8*4)) &&& 255) 0 <<< (8*4) + lookupTable.getD ((x >>> (8*5)) &&& 255) 0 <<< (8*5) + lookupTable.getD ((x >>> (8*6)) &&& 255) 0 <<< (8*6) + lookupTable.getD ((x >>> (8*7)) &&& 255) 0 <<< (8*7) := by
  unfold lookupLane
  rfl
theorem lk_lit (x : Nat) : lookupLane x =
  lookupTable.getD (x % 256) 0 + lookupTable.getD (x / 256 % 256) 0 * 256 + lookupTable.getD (x / 65536 % 256) 0 * 65536 +
  lookupTable.getD (x / 16777216 % 256) 0 * 16777216 + lookupTable.getD (x / 4294967296 % 256) 0 * 4294967296 +
  lookupTable.getD (x / 1099511627776 % 256) 0 * 1099511627776 + lookupTable.getD (x / 281474976710656 % 256) 0 * 281474976710656 +
  lookupTable.getD (x / 72057594037927936 % 256) 0 * 72057594037927936 := by
  rw [lk_unroll]
  simp only [Nat.shiftRight_eq_div_pow, Nat.shiftLeft_eq, and255, Nat.reducePow, Nat.reduceMul, Nat.zero_add, Nat.div_one, Nat.mul_one]
theorem lkU_spec (w : UInt64) : (lkU w).toNat = lookupLane w.toNat := by
  rw [lk_lit]
  have t0 : (tw w 0).toNat = _ := tw_spec w 0 (by decide) (by decide)
  have t1 : (tw w 8).toNat = _ := tw_spec w 8 (by decide) (by decide)
  have t2 : (tw w 16).toNat = _ := tw_spec w 16 (by decide) (by decide)
  have t3 : (tw w 24).toNat = _ := tw_spec w 24 (by decide) (by decide)
  have t4 : (tw w 32).toNat = _ := tw_spec w 32 (by decide) (by decide)
  have t5 : (tw w 40).toNat = _ := tw_spec w 40 (by decide) (by decide)
  have t6 : (tw w 48).toNat = _ := tw_spec w 48 (by decide) (by decide)
  have t7 : (tw w 56).toNat = _ := tw_spec w 56 (by decide) (by decide)
  simp only [Nat.reducePow] at t0 t1 t2 t3 t4 t5 t6 t7
  have b0 := tab_lt (w.toNat / 1 % 256)
  have b1 := tab_lt (w.toNat / 256 % 256)
  have b2 := tab_lt (w.toNat / 65536 % 256)
  have b3 := tab_lt (w.toNat / 16777216 % 256)
  have b4 := tab_lt (w.toNat / 4294967296 % 256)
  have b5 := tab_lt (w.toNat / 1099511627776 % 256)
  have b6 := tab_lt (w.toNat / 281474976710656 % 256)
  have b7 := tab_lt (w.toNat / 72057594037927936 % 256)
  simp only [tabA_getD, Nat.div_one] at b0 b1 b2 b3 b4 b5 b6 b7 t0
  simp only [lkU, UInt64.toNat_add, t0, t1, t2, t3, t4, t5, t6, t7, Nat.div_one, Nat.mul_one]
  omega
@[inline] def canon (r : UInt64) : UInt64 := if r < 18446744069414584321 then r else r - 18446744069414584321
theorem canon_spec (r : UInt64) : (canon r).toNat = r.toNat % P := by
  have h := UInt64.toNat_lt r
  have hP : P = 18446744069414584321 := rfl
  have c : (18446744069414584321 : UInt64).toNat = 18446744069414584321 := rfl
  unfold canon
  by_cases hc : r < 18446744069414584321
  · rw [if_pos hc]; rw [UInt64.lt_iff_toNat_lt, c] at hc; rw [hP]; omega
  · rw [if_neg hc]; rw [UInt64.lt_iff_toNat_lt, c] at hc
    rw [UInt64.toNat_sub, c, hP]; omega
@[inline] def laneU (rc H L : UInt64) : UInt64 :=
  let loH := H <<< 32
  let s1 := loH + L
  let c1 : UInt64 := if s1 < loH then 1 else 0
  let s2 := s1 + rc
  let c2 : UInt64 := if s2 < s1 then 1 else 0
  canon (reduce128 ((H >>> 32) + c1 + c2) s2)
theorem laneU_spec (rc H L : UInt64) (hH : H.toNat < 4503599627370496) (hL : L.toNat < 4503599627370496) :
    (laneU rc H L).toNat = (rc.toNat + (H.toNat * 4294967296 + L.toNat)) % P := by
  have hc : (1 : UInt64).toNat = 1 := rfl
  have h0 : (0 : UInt64).toNat = 0 := rfl
  have c32 : (32 : UInt64).toNat = 32 := rfl
  have hr := UInt64.toNat_lt rc
  unfold laneU
  rw [canon_spec, reduce128_spec]
  have hs : (H <<< 32).toNat = H.toNat * 4294967296 % 18446744073709551616 := by
    rw [UInt64.toNat_shiftLeft, c32, Nat.shiftLeft_eq]
  have hsr : (H >>> 32).toNat = H.toNat / 4294967296 := sr32 H
  by_cases c1 : (H <<< 32) + L < H <<< 32 <;> by_cases c2 : ((H <<< 32) + L) + rc < (H <<< 32) + L <;>
  · simp only [c1, c2, ite_true, ite_false]
    simp only [UInt64.lt_iff_toNat_lt, UInt64.toNat_add, hs, hsr, hc, h0] at c1 c2 ⊢
    exact modeq_of _ _ 0 (by omega)


