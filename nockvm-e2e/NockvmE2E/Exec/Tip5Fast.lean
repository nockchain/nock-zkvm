/-! ### sponge on top (same shapes as `Tip5Core`, calling `permuteF`) -/
def absorbBlockF (s : List Nat) (blk : List Nat) : List Nat := permuteF (blk ++ s.drop RATE)
theorem absorbBlockF_eq : absorbBlockF = absorbBlock := by
  funext s blk; simp only [absorbBlockF, absorbBlock, permuteF_eq]
def absorbFuelF : Nat → List Nat → List Nat → List Nat
  | 0, s, _ => s
  | n + 1, s, l => if l.isEmpty then s else absorbFuelF n (absorbBlockF s (l.take RATE)) (l.drop RATE)
theorem absorbFuelF_eq : absorbFuelF = absorbFuel := by
  funext n
  induction n with
  | zero => rfl
  | succ n ih => funext s l; simp only [absorbFuelF, absorbFuel, ih, absorbBlockF_eq]
def hashVarlenF (inp : List Nat) : List Nat :=
  let blocks := (pad inp).map montify
  digestOf (absorbFuelF (blocks.length / RATE + 1) initVar blocks)
theorem hashVarlenF_eq : hashVarlenF = hashVarlen := by
  funext inp; simp only [hashVarlenF, hashVarlen, absorbFuelF_eq]
def hash10F (inp : List Nat) : List Nat :=
  digestOf (permuteF ((inp.map montify) ++ initFixed.drop RATE))
theorem hash10F_eq : hash10F = hash10 := by
  funext inp; simp only [hash10F, hash10, permuteF_eq]
def absorbF (s : List Nat) (t : Nat) (data : List Nat) : List Nat :=
  hashVarlenF ([tAbs] ++ s ++ [t, data.length] ++ data)
theorem absorbF_eq : absorbF = absorb := by
  funext s t d; simp only [absorbF, absorb, hashVarlenF_eq]
def squeezeF (s : List Nat) (n : Nat) : List Nat :=
  ((List.range ((n + 4) / 5)).flatMap fun k => hashVarlenF ([tSqz] ++ s ++ [k])).take n
theorem squeezeF_eq : squeezeF = squeeze := by
  funext s n; simp only [squeezeF, squeeze, hashVarlenF_eq]

/-! ### csimp registrations: compiled code in importing modules calls the fast versions -/
@[csimp] theorem permute_csimp : @Tip5Core.permute = @permuteF := permuteF_eq.symm
@[csimp] theorem absorbBlock_csimp : @Tip5Core.absorbBlock = @absorbBlockF := absorbBlockF_eq.symm
@[csimp] theorem absorbFuel_csimp : @Tip5Core.absorbFuel = @absorbFuelF := absorbFuelF_eq.symm
@[csimp] theorem hashVarlen_csimp : @Tip5Core.hashVarlen = @hashVarlenF := hashVarlenF_eq.symm
@[csimp] theorem hash10_csimp : @Tip5Core.hash10 = @hash10F := hash10F_eq.symm
@[csimp] theorem absorb_csimp : @Tip5Core.absorb = @absorbF := absorbF_eq.symm
@[csimp] theorem squeeze_csimp : @Tip5Core.squeeze = @squeezeF := squeezeF_eq.symm

