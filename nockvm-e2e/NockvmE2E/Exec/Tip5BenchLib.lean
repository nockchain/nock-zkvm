/-- compiled before `Tip5Fast` exists: always the slow List version. -/
def slowHash (x : List Nat) : List Nat := Tip5Core.hashVarlen x

def checkVectors (hv h10 perm : List Nat → List Nat) : Nat × Nat :=
  vectors.foldl (fun (ok, bad) (t, _, i, e) =>
    let r := if t == 0 then hv i else if t == 1 then h10 i else perm i
    if r == e then (ok + 1, bad) else (ok, bad + 1)) (0, 0)

def timeIt (f : List Nat → List Nat) (n : Nat) : IO Nat := do
  let t0 ← IO.monoNanosNow
  let mut acc := 0
  for k in [0:n] do
    let r := f ((List.range 16).map fun j => (k * 16 + j) * 123456789)
    acc := acc + r.headD 0 % 7
  let t1 ← IO.monoNanosNow
  IO.println s!"  (sink {acc})"
  return (t1 - t0) / 1000 * 1000 / n   -- ns per call, coarse

end NockvmE2E.Exec.Tip5Bench
