  `Nock.NockVMROM.Thm54.FormRCore.Majorant, `Nock.NockVMROM.Thm54.FormRCore.Mtree,
  -- 4.35: `formRRootBad.eq_1` is now generated on demand in this module (the source edit of

  `Nock.NockVMROM.Thm54.FormRBridgeTelescope]


def disclosedThm : Array Name := #[
  `Nock.RedTeam.Batch556.event_probability_le,

  -- `finset_sum_range_eq_list`, whose auto-generated private name shifted when the module lost
  -- the declarations moved to `FormRTemplatePolynomial`.  TYPE unchanged (checked above).
  `Nock.NockVMROM.Thm54.FormRAxisEvent.encode_Cprime_eq_C'poly_eval]

structure Report where
  missing : Array Name := #[]
  typeMoved : Array Name := #[]
  valueMoved : Array Name := #[]
  thmProofMoved : Array Name := #[]
  badModule : Array (Name × Name) := #[]
  moved : Nat := 0

def check (env : Environment) (rows : Array (Name × Name × String × UInt64 × UInt64)) : Report := Id.run do
  let mut r : Report := {}
  for (m, n, kind, th, vh) in rows do
    match env.find? n with
    | none => r := { r with missing := r.missing.push n }
    | some ci =>
      if ci.type.hash != th then r := { r with typeMoved := r.typeMoved.push n }
      let vh' : UInt64 := match ci.value? (allowOpaque := true) with | some v => v.hash | none => 0
      if vh' != vh then
        if kind == "thm" then r := { r with thmProofMoved := r.thmProofMoved.push n }
        else r := { r with valueMoved := r.valueMoved.push n }
      match env.getModuleFor? n with
      | some m' =>
          if m' != m then r := { r with moved := r.moved + 1 }
          unless allowedModules.contains m' do r := { r with badModule := r.badModule.push (n, m') }
      | none => r := { r with badModule := r.badModule.push (n, `_none) }
  return r

run_cmd do
  let env ← getEnv
  let r := check env baseline
  logInfo m!"rows {baseline.size}; missing {r.missing.size}; type moved {r.typeMoved.size}; \
    def/ind/ctor value moved {r.valueMoved.size}; theorem proof moved {r.thmProofMoved.size}; \
    relocated {r.moved}; bad module {r.badModule.size}"
  logInfo m!"theorem proofs moved: {r.thmProofMoved}"
  unless r.missing.isEmpty do throwError m!"missing: {r.missing}"
  unless r.typeMoved.isEmpty do throwError m!"TYPE moved (a statement changed): {r.typeMoved}"
  unless r.valueMoved.isEmpty do throwError m!"definition value moved: {r.valueMoved}"
  unless r.badModule.isEmpty do throwError m!"unexpected module: {r.badModule}"
  -- every moved proof is an `eq_def` or in the disclosed list
  for n in r.thmProofMoved do
    unless n.components.contains `eq_def ∨ disclosedThm.contains n ∨
        (n.toString.endsWith "eq_def") do
      throwError m!"undisclosed proof change: {n}"

  unless r.thmProofMoved.size == 0 do throwError m!"expected no proof changes against the 4.35 re-measure: {r.thmProofMoved.size}"
  -- positive control: swap one row's type hash with another's; the checker must flag it
  let some (m0, n0, k0, _, v0) := baseline[0]? | throwError "empty baseline"
  let some (_, _, _, th1, _) := baseline[1]? | throwError "short baseline"
  let r' := check env #[(m0, n0, k0, th1, v0)]
  unless r'.typeMoved.size == 1 do throwError "positive control failed: swapped type hash not flagged"
  logInfo "positive control: swapped type hash flagged"

end Nock.RedTeam.Batch656
