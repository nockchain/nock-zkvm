namespace Nock.RedTeam.Batch1761
def consts (ci : ConstantInfo) : Array Name := Id.run do
  let mut es : Array Expr := #[ci.type]
  if let some v := ci.value? (allowOpaque := true) then es := es.push v
  let mut out : NameSet := {}
  for e in es do
    for n in e.getUsedConstants do out := out.insert n
  return out.toArray
def tracked (n : Name) : Bool := (`Nock).isPrefixOf n || (`Nock.Walk37).isPrefixOf n
partial def reach (env : Environment) (roots : List Name) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut stack : Array Name := roots.toArray
  while !stack.isEmpty do
    let n := stack.back!
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    match env.find? n with
    | none => pure ()
    | some ci =>
      let mut nxt := consts ci
      match ci with
      | .inductInfo i => nxt := nxt ++ i.ctors.toArray
      | .ctorInfo c => nxt := nxt.push c.induct
      | _ => pure ()
      for m in nxt do
        if tracked m && !seen.contains m then stack := stack.push m
  return seen
end Nock.RedTeam.Batch1761

