/-- `exactAxisTree` depends only on the underlying configuration and execution. -/
theorem exactAxisTree_congr
    {cfg₁ cfg₂ : ExactConfig F K}
    {exec₁ : ExactExecution cfg₁} {exec₂ : ExactExecution cfg₂}
    (hcfg : cfg₁ = cfg₂) (hexec : HEq exec₁ exec₂) (i : Fin cfg₁.kMem) :
    exactAxisTree cfg₁ exec₁ i =
      exactAxisTree cfg₂ exec₂ ⟨i.val, hcfg ▸ i.isLt⟩ := by
  cases hcfg
  cases hexec
  rfl

/-- Per-root axis boundary at the honest sample: the template polynomial
evaluates to zero because the specialized `countsP` is the zero polynomial.  Independent of later-round `(a, g)`. -/
theorem honest_templateAxisPolynomial_eval {E : BuildableNockExecution F K}
    (D : Data E) :
    ∀ i : Fin (configTemplateOf E E.cfg.challenges.z).kMem,
      (countsP_bin
        (templateAxisTree
          (templateMemoryTreeAt (D.executionTemplate E.cfg.challenges.z) i))).eval
        E.cfg.challenges.α = 0 := by
  intro i
  have heval := specialized_countsP_bin_eval
    (D.executionTemplate E.cfg.challenges.z) E.cfg.challenges.α (lmb := E.cfg.challenges.lam) i
  rw [← heval]
  have hcfg := D.honest_cfg
  have hexec := heq_of_eq D.honest_execA
  have htree := exactAxisTree_congr hcfg hexec i
  have hzero := rootPolynomial_of_exactMemoryAxisValidity E.two_ne_zero
    E.memoryTrace.axisStructural E.memoryTrace.axisValidity E.memoryTrace.support
      ⟨i.val, hcfg ▸ i.isLt⟩
  rw [htree, hzero]
  simp

/-- Production per-root axis boundary of the constructed package at the honest
sample.  Not `structuralChecksAt`, and not `strategy.Accepts`. -/
theorem packageOf_fibre_root_axis_boundary {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F) :
    (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.RootAxisBoundaryAt
      E.cfg.challenges.z D.honestSeed_ne E.cfg.challenges.α := by
  intro i
  have htmpl := packageOf_committedTemplate D hgt I hprl hmore hord hordM hrows hgenF hF
  have hbound := honest_templateAxisPolynomial_eval D
  revert i
  rw [htmpl]
  exact hbound

/-- Production `strategy.Accepts` on the honest fibre is exactly the remaining
α-free / no-wrap structural check.  Residual `verifier.Accepts` and `RootAxisBoundaryAt` are already compiled.
Not `∀ ω` -/
theorem packageOf_fibre_accepts_iff_structural {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (a g : K) :
    (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.Accepts (honestCoin E a g) E.cfg.challenges.lam ↔
      structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
        (nprSeed (honestCoin E a g)) D.honestSeed_ne
        (alphaM (honestCoin E a g)) = true := by
  have hz : nprSeed (honestCoin E a g) ≠ 0 := D.honestSeed_ne
  constructor
  · intro hacc
    have haxis := ((packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.accepts_iff
      (honestCoin E a g) E.cfg.challenges.lam hz).1 hacc
    exact ((ProductionAxisStructureVerifier.accepts_iff
      (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier (honestCoin E a g) E.cfg.challenges.lam hz).1
      haxis.1).2
  · intro hstruct
    apply ((packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.accepts_iff
      (honestCoin E a g) E.cfg.challenges.lam hz).2
    constructor
    · apply (ProductionAxisStructureVerifier.accepts_iff
        (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier (honestCoin E a g) E.cfg.challenges.lam hz).2
      refine ⟨?_, hstruct⟩
      · exact ((packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier.accepts_iff_production
          (honestCoin E a g) E.cfg.challenges.lam hz).1
          (packageOf_fibre_verifier_accepts D hgt I hprl hmore hord hordM hrows hgenF hF a g)
    · change (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.RootAxisBoundaryAt
        (nprSeed (honestCoin E a g)) hz (alphaM (honestCoin E a g))
      simpa [honestCoin, nprSeed, alphaM] using
        packageOf_fibre_root_axis_boundary D hgt I hprl hmore hord hordM hrows hgenF hF

theorem packageOf_structuralChecksAt_splits {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F) :
    structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
      E.cfg.challenges.z D.honestSeed_ne E.cfg.challenges.α =
      (alphaFreeAxisStructureCheck
        (committedTemplate (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
          E.cfg.challenges.z D.honestSeed_ne) &&
        noWrapCheck
          (committedTemplate (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
            E.cfg.challenges.z D.honestSeed_ne)
          E.cfg.challenges.α) :=
  rfl

/-- Inhabited below from specialized refinement
plus the paper uniqueness window. -/
theorem packageOf_fibre_accepts_of_structural {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (hstruct :
      structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
        E.cfg.challenges.z D.honestSeed_ne E.cfg.challenges.α = true) :
    ∀ a g : K,
      (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.Accepts (honestCoin E a g) E.cfg.challenges.lam := by
  intro a g
  refine (packageOf_fibre_accepts_iff_structural D hgt I hprl hmore hord hordM hrows hgenF hF a g).2 ?_
  simpa [honestCoin, nprSeed, alphaM] using hstruct

/-! ## Structural checks at honest `alphaM`

`alphaFreeAxisStructureCheck` is α-free on the committed template.
`noWrapCheck` sees only honest `alphaM`.  Neither depends on later-round
`(a, g)`.  The remaining named paper premise is the uniqueness window of
timestamps `α^i` on the committed forest.

**Cite discipline for this section.**
The axis batching that these Booleans decide is the paper, with the
`axis_counts`/`axis_indicator` zero check at `halt` on the paper; the
closed-form timestamps `z^i` are the paper; the IO/`intermediate` multiset
accounting together with `z^i` multiplicative uniqueness is the paper; the
negligibility window in which those exponents stay distinct is -/

/-- Paper uniqueness of timestamps `α^i` on the committed forest: every read and every verify exponent of the α-free
template lies below `orderOf alphaM`. -/
def ForestExponentOrder
    {T : ExactConfigTemplate F K} (E : ExactExecutionTemplate T) (α : K) : Prop :=
  (∀ i e, e ∈ readExps (alphaFreeRoot E i) → e < orderOf α) ∧
    (∀ i e, e ∈ verifyExps (alphaFreeRoot E i) → e < orderOf α)

/-- The uniqueness window is a property of the committed template and honest
`alphaM`, not of later-round `(a, g)` -/
theorem ForestExponentOrder_of_honestCoin {E : BuildableNockExecution F K}
    (D : Data E) (a g : K) :
    ForestExponentOrder
        (D.executionTemplate (nprSeed (honestCoin E a g)))
        (alphaM (honestCoin E a g)) =
      ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
        E.cfg.challenges.α := by
  simp only [honestCoin, nprSeed, alphaM]

/-- Specialized structural refinement of the honest sample, on the committed
template.  Not the α-free Boolean -/
theorem packageOf_specialized_structural {E : BuildableNockExecution F K}
    (D : Data E) :
    ExactAxisStructuralRefinement
      ((configTemplateOf E E.cfg.challenges.z).specialize E.cfg.challenges.α E.cfg.challenges.lam)
      ((D.executionTemplate E.cfg.challenges.z).specializeA E.cfg.challenges.α E.cfg.challenges.lam) :=
  D.honest_execA.symm ▸ E.memoryTrace.axisStructural

/-- Read-exponent uniqueness on the committed template, from specialized
timestamp uniqueness.  Independent of the uniqueness window and of `(a, g)`. -/
theorem packageOf_read_exponents_nodup {E : BuildableNockExecution F K}
    (D : Data E) :
    ∀ i, (readExps (alphaFreeRoot (D.executionTemplate E.cfg.challenges.z) i)).Nodup := by
  intro i
  simpa [alphaFreeRoot] using
    TemplateAxisStructure.template_readExps_nodup_of_specialized
      (D.executionTemplate E.cfg.challenges.z) E.cfg.challenges.α
      (packageOf_specialized_structural D) i

/-- No-wrap at honest `alphaM` is the read half of the paper uniqueness window:
closed-form timestamps `z^i` plus the IO/`intermediate`
accounting and `z^i` uniqueness, inside the negligibility
window.  Independent of later-round `(a, g)`. -/
theorem packageOf_noWrapCheck {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (horder : ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α) :
    noWrapCheck
      (committedTemplate (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
        E.cfg.challenges.z D.honestSeed_ne)
      E.cfg.challenges.α = true := by
  rw [packageOf_committedTemplate D hgt I hprl hmore hord hordM hrows hgenF hF]
  exact (noWrapCheck_eq_true_iff _ _).2 horder.1

/-- α-free axis structure on the committed template, from specialized
refinement plus the uniqueness window.  Independent of later-round `(a, g)`. -/
theorem packageOf_alphaFreeAxisStructureCheck {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (horder : ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α) :
    alphaFreeAxisStructureCheck
      (committedTemplate (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
        E.cfg.challenges.z D.honestSeed_ne) = true := by
  rw [packageOf_committedTemplate D hgt I hprl hmore hord hordM hrows hgenF hF]
  exact (alphaFreeAxisStructureCheck_eq_true_iff _).2
    (alphaFreeAxisStructure_of_specialized
      (D.executionTemplate E.cfg.challenges.z) E.cfg.challenges.α
      (packageOf_specialized_structural D) horder.1 horder.2)

/-- Both structural-check halves on the committed template at honest `alphaM`.
Independent of later-round `(a, g)`. -/
theorem packageOf_structuralChecksAt {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (horder : ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α) :
    structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
      E.cfg.challenges.z D.honestSeed_ne E.cfg.challenges.α = true := by
  rw [packageOf_structuralChecksAt_splits D hgt I hprl hmore hord hordM hrows hgenF hF]
  simp [packageOf_alphaFreeAxisStructureCheck D hgt I hprl hmore hord hordM hrows hgenF hF horder,
    packageOf_noWrapCheck D hgt I hprl hmore hord hordM hrows hgenF hF horder]

/-- The remaining Boolean is the committed template at honest `(z, α)`, not a
function of later-round `(a, g)` -/
theorem packageOf_structuralChecksAt_ignores_later_round
    {E : BuildableNockExecution F K} (D : Data E) (hgt : 11 < ringChar K)
    (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (a g : K) :
    structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
      (nprSeed (honestCoin E a g)) D.honestSeed_ne
      (alphaM (honestCoin E a g)) =
      structuralChecksAt (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.verifier
        E.cfg.challenges.z D.honestSeed_ne E.cfg.challenges.α := by
  simp [honestCoin, nprSeed, alphaM]

/-- Production fibre `Accepts` at `honestCoin`, for `∀ a g`, from the paper
uniqueness window on the committed forest.  Not `∀ ω`. -/
theorem packageOf_fibre_accepts {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (horder : ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α) :
    ∀ a g : K,
      (packageOf D hgt I hprl hmore hord hordM hrows hgenF hF).strategy.Accepts (honestCoin E a g) E.cfg.challenges.lam :=
  packageOf_fibre_accepts_of_structural D hgt I hprl hmore hord hordM hrows hgenF hF
    (packageOf_structuralChecksAt D hgt I hprl hmore hord hordM hrows hgenF hF horder)

/-! ## `ForestExponentOrder` does not follow from `E` / named premises

The paper uniqueness window is that committed forest
read/verify exponents lie below `orderOf alphaM`.  `timestampClosed` is only
`∃ e, ts = α^e`.  `SemanticIOPreimage` bounds derived-IO Nats on specialized
`cfg`/`exec`.  `MemoryTimestampSpecializesAt` is wrapping-stable:
`α^(e + orderOf α) = α^e`.  Template tree exponents are the committed
`recordExponent` Nats, not those derived-IO residues.  Identifying the two
as Nats (not merely as field powers) is the missing hypothesis; wrapping
shows why `Data` / `timestampClosed` do not supply it.
`packageOf_fibre_accepts` therefore still takes the extra. -/

/-- Paper closed form is existence of some exponent, not the uniqueness
window `e < orderOf α`. -/
theorem timestampClosed_is_existence (α ts : K) :
    MemoryTimestampClosedAt α ts = ∃ e : ℕ, ts = α ^ e :=
  rfl

/-- Wrapping a closed-form witness: if `ts = α^e` then also
`ts = α^(e + orderOf α)`.  The second witness is never below `orderOf α`
when that order is positive -/
theorem timestampClosed_witness_add_order {α ts : K} {e : ℕ}
    (h : ts = α ^ e) :
    ts = α ^ (e + orderOf α) := by
  rw [h, pow_add, pow_orderOf_eq_one, mul_one]

theorem wrapped_exponent_not_lt_order {α : K} {e : ℕ}
    (hpos : 0 < orderOf α) :
    ¬ e + orderOf α < orderOf α := by
  omega

/-- `MemoryTimestampSpecializesAt` — the Data-level timestamp constraint —
is wrapping-stable.  It does not pin the canonical residue. -/
theorem MemoryTimestampSpecializesAt_add_order
    {α : K} {stamp : MemoryTimestampRow}
    {row : MemoryTable.MState × MemoryTable.DTmem K}
    (h : MemoryTimestampSpecializesAt α stamp row) :
    MemoryTimestampSpecializesAt α
      { stamp with recordExponent := stamp.recordExponent + orderOf α } row := by
  obtain ⟨houter, hst, hts, hpad⟩ := h
  refine ⟨houter, hst, ?_, hpad⟩
  by_cases hact : memoryMemRecKind stamp.state = .active
  · simp [hact] at hts ⊢
    rw [← timestampClosed_witness_add_order
      (rfl : α ^ stamp.recordExponent = α ^ stamp.recordExponent)]
    exact hts
  · simp [hact] at hts ⊢
    exact hts

/-- A read exponent outside the window refutes `ForestExponentOrder`. -/
theorem ForestExponentOrder_fails_of_large_readExp
    {T : ExactConfigTemplate F K} (E : ExactExecutionTemplate T) (α : K)
    {i : Fin T.kMem} {e : ℕ}
    (he : e ∈ readExps (alphaFreeRoot E i))
    (hge : ¬ e < orderOf α) :
    ¬ ForestExponentOrder E α := by
  intro h
  exact hge (h.1 i e he)

/-- A verify exponent outside the window likewise refutes the uniqueness
window -/
theorem ForestExponentOrder_fails_of_large_verifyExp
    {T : ExactConfigTemplate F K} (E : ExactExecutionTemplate T) (α : K)
    {i : Fin T.kMem} {e : ℕ}
    (he : e ∈ verifyExps (alphaFreeRoot E i))
    (hge : ¬ e < orderOf α) :
    ¬ ForestExponentOrder E α := by
  intro h
  exact hge (h.2 i e he)

/-- `E` already supplies a global semantic-IO timestamp preimage.  That object
bounds derived-IO record Nats on specialized `cfg`/`exec`, not α-free template
tree exponents -/
theorem timestampBounds_are_semantic_preimage
    (E : BuildableNockExecution F K) :
    Nonempty (SemanticIOPreimage E.cfg E.exec) :=
  E.timestampBounds

theorem semantic_preimage_bounds_derived_io_nats
    {cfg : ExactConfig F K} {exec : ExactExecution cfg}
    (w : SemanticIOPreimage cfg exec) :
    (∀ r ∈ w.semanticRequests, r.2.2 < orderOf cfg.challenges.α) ∧
      (∀ r ∈ w.semanticResponses, r.2.2 < orderOf cfg.challenges.α) :=
  ⟨w.requestTimestamp_lt_order, w.responseTimestamp_lt_order⟩

/-- **Missing identification.**  If every committed-forest read and verify
exponent *equals* some `SemanticIOPreimage` Nat (not merely the same field
power `α^e`), the uniqueness window follows from that preimage.
`timestampClosed` / `MemoryTimestampSpecializesAt` give only the field-power
equation, which wrapping preserves -/
theorem ForestExponentOrder_of_identified_semantic_nats
    {E : BuildableNockExecution F K} (D : Data E)
    (w : SemanticIOPreimage E.cfg E.exec)
    (hread :
      ∀ i e, e ∈ readExps
          (alphaFreeRoot (D.executionTemplate E.cfg.challenges.z) i) →
        (∃ r ∈ w.semanticRequests, r.2.2 = e) ∨
          (∃ r ∈ w.semanticResponses, r.2.2 = e))
    (hverify :
      ∀ i e, e ∈ verifyExps
          (alphaFreeRoot (D.executionTemplate E.cfg.challenges.z) i) →
        (∃ r ∈ w.semanticRequests, r.2.2 = e) ∨
          (∃ r ∈ w.semanticResponses, r.2.2 = e)) :
    ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α := by
  refine ⟨?_, ?_⟩
  · intro i e he
    rcases hread i e he with ⟨r, hr, heq⟩ | ⟨r, hr, heq⟩
    · exact heq ▸ w.requestTimestamp_lt_order r hr
    · exact heq ▸ w.responseTimestamp_lt_order r hr
  · intro i e he
    rcases hverify i e he with ⟨r, hr, heq⟩ | ⟨r, hr, heq⟩
    · exact heq ▸ w.requestTimestamp_lt_order r hr
    · exact heq ▸ w.responseTimestamp_lt_order r hr

/-! ## `sizeWindowBound` does not follow from `ForestExponentOrder` /
`nounSizeBound` / sampled `SizeWindow`

The NPR leaf window is `n.leaves ≤ Λ` on OP3/OP4/OP6 skeleton products.
Sampled `SizeWindow` is `1 < orderOf z` and `n.leaves < orderOf z`.
`ForestExponentOrder` is `e < orderOf α` on committed template Nats.  `nounSizeBound = E.Λ` is the committed numeral,
already assembled.  These are different objects.  SizeWindow is not
weakened to `≤ Λ`. -/

/-- The named extra is the seed-independent leaf bound `n.leaves ≤ Λ`. -/
theorem sizeWindowBound_is_leaves_le_Lambda
    {S : SemanticStrategy.SemanticSkeleton} {Λ : ℕ} :
    SizeWindowCounting.SizeWindowNounsBoundedBy S Λ =
      ∀ n ∈ SizeWindowCounting.skeletonSizeWindowNouns S, n.leaves ≤ Λ :=
  rfl

/-- Sampled `SizeWindow` is the multiplicative-order bound at seed `z`,
not the named `Λ` extra -/
theorem SizeWindow_is_leaves_lt_orderOf {z : K} {n : Noun}
    (hw : OpcodeSemantics.SizeWindow z n) :
    1 < orderOf z ∧ n.leaves < orderOf z :=
  ⟨hw.one_lt_order, hw.leaves_lt_order⟩

/-- `ForestExponentOrder` bounds committed template Nats against
`orderOf α`, not noun leaves against `Λ` -/
theorem ForestExponentOrder_is_exponent_window
    {T : ExactConfigTemplate F K} (Et : ExactExecutionTemplate T) (α : K) :
    ForestExponentOrder Et α =
      ((∀ i e, e ∈ readExps (alphaFreeRoot Et i) → e < orderOf α) ∧
        (∀ i e, e ∈ verifyExps (alphaFreeRoot Et i) → e < orderOf α)) :=
  rfl

/-- On the honest sample the uniqueness window uses `α`, not the NPR seed
`z` -/
theorem ForestExponentOrder_uses_alpha {E : BuildableNockExecution F K}
    (D : Data E) :
    ForestExponentOrder (D.executionTemplate E.cfg.challenges.z)
      E.cfg.challenges.α =
      ((∀ i e, e ∈ readExps
          (alphaFreeRoot (D.executionTemplate E.cfg.challenges.z) i) →
        e < orderOf E.cfg.challenges.α) ∧
        (∀ i e, e ∈ verifyExps
          (alphaFreeRoot (D.executionTemplate E.cfg.challenges.z) i) →
        e < orderOf E.cfg.challenges.α)) :=
  rfl

/-- Already-held numeral: `nounSizeBound` of assembled `Data` is `E.Λ`.
This is not a proof that window-noun leaves are `≤ Λ` -/
theorem nounSizeBound_of_census_is_Lambda
    (E : BuildableNockExecution F K) (P : ResidualPremises E)
    (M : MemoryRecordPremises E) (C : CensusRecordPremises E P M)
    (hln : Nock.NockVMROM.Thm54.GenericHonestCommitment.FirstLineStartsAtOne E.exec) :
    (dataOfCensus E P M C hln).nounSizeBound = E.Λ ∧
      (dataOfCensus E P M C hln).Λ = E.Λ :=
  ⟨(dataOfCensus_derived_fields E P M C hln).1,
    (dataOfCensus_derived_fields E P M C hln).2.2⟩

/-- **Missing hypothesis.**  Sampled `SizeWindow` at `z` inhabits
`sizeWindowBound` only with the additional comparison `orderOf z ≤ Λ + 1`.
`ForestExponentOrder` bounds template Nats against `orderOf α` and does
not supply this.  `nounSizeBound = E.Λ` is the numeral, not the comparison.
SizeWindow is not weakened -/
theorem sizeWindowBound_of_SizeWindow_and_order_le_succ_Lambda
    {S : SemanticStrategy.SemanticSkeleton} {z : K} {Λ : ℕ}
    (hw : ∀ n ∈ SizeWindowCounting.skeletonSizeWindowNouns S,
      OpcodeSemantics.SizeWindow z n)
    (hord : orderOf z ≤ Λ + 1) :
    SizeWindowCounting.SizeWindowNounsBoundedBy S Λ := by
  intro n hn
  exact Nat.lt_succ_iff.mp (lt_of_lt_of_le (hw n hn).leaves_lt_order hord)

/-- A window noun with `leaves = Λ + 1` refutes the named extra. -/
theorem sizeWindowBound_fails_of_leaves_succ
    {S : SemanticStrategy.SemanticSkeleton} {Λ : ℕ} {n : Noun}
    (hn : n ∈ SizeWindowCounting.skeletonSizeWindowNouns S)
    (hleaves : n.leaves = Λ + 1) :
    ¬ SizeWindowCounting.SizeWindowNounsBoundedBy S Λ := by
  intro h
  have : n.leaves ≤ Λ := h n hn
  rw [hleaves] at this
  exact Nat.not_succ_le_self Λ this

/-- SizeWindow can still hold for that noun when `Λ + 1 < orderOf z`.
The predicates are therefore distinct -/
theorem SizeWindow_holds_of_leaves_succ_lt_order
    {z : K} {n : Noun} {Λ : ℕ}
    (hleaves : n.leaves = Λ + 1)
    (hord : Λ + 1 < orderOf z) :
    OpcodeSemantics.SizeWindow z n := by
  refine ⟨lt_of_le_of_lt (Nat.le_add_left 1 Λ) hord, ?_⟩
  simpa [hleaves] using hord

/-- Fold-`2` specialization: same residual, selector slot `36` equal to `2`. -/
def packageOfFold2 {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ := by claim_generated)
    (hF : GeneratedField.PrimeFieldElems F := by prime_field_elems) :
    OptimizedFullStrictNockVMROMPackage F K I.hOrb :=
  packageOf D hgt (inputsFold2 I) hprl hmore hord hordM hrows hgenF hF

theorem packageOfFold2_eq {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F) :
    packageOfFold2 D hgt I hprl hmore hord hordM hrows hgenF hF =
      packageOf D hgt (inputsFold2 I) hprl hmore hord hordM hrows hgenF hF :=
  rfl

/-- Whole-joint `∀ ω` is uninhabited: production `Accepts` is `False` on a
zero NPR seed -/
theorem packageOf_not_forall_omega {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
