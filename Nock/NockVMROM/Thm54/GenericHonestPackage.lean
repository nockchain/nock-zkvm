/-! ## Thread walk RAP samples into `Inputs` from fibre `(a, g)`

The verifier samples `(α, γ)` after the walk commitment.
Fibre `Accepts` is already `∀ a g` over that pair (`honestCoin`).  The
additive overlay reads chip `computeWalkAlpha` / `walkGamma` from the
same `(a, g)`.  It does not pick a unique pair.  `packageOf`'s existing
signature is unchanged.  IO coins stay named. -/

/-- Overlay the walk RAP sample `(α, γ)` onto a named
`Inputs` record.  Remaining fields, including FiniteIO coins and compiler
folds, stay the caller's named values -/
def inputsOfWalkSample {E : BuildableNockExecution F K} (I : Inputs E)
    (a g : K) : Inputs E :=
  { I with computeWalkAlpha := a, walkGamma := g }

/-- Chip walk coins are the overlaid sample.  Not a unique pair. -/
theorem inputsOfWalkSample_walk_coins {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    (inputsOfWalkSample I a g).computeWalkAlpha = a ∧
      (inputsOfWalkSample I a g).walkGamma = g :=
  ⟨rfl, rfl⟩

/-- Those chip coins are the same `(a, g)` the fibre already quantifies. -/
theorem inputsOfWalkSample_eq_honestCoin_walk
    {E : BuildableNockExecution F K} (I : Inputs E) (a g : K) :
    (inputsOfWalkSample I a g).computeWalkAlpha = alphaC (honestCoin E a g) ∧
      (inputsOfWalkSample I a g).walkGamma = gamma (honestCoin E a g) :=
  ⟨rfl, rfl⟩

/-- Distinct later-round pairs remain distinct after overlay. -/
theorem inputsOfWalkSample_injective_on_walk_pair
    {E : BuildableNockExecution F K} (I : Inputs E) {a g a' g' : K}
    (h : inputsOfWalkSample I a g = inputsOfWalkSample I a' g') :
    a = a' ∧ g = g' := by
  have ha := congrArg Inputs.computeWalkAlpha h
  have hg := congrArg Inputs.walkGamma h
  exact ⟨ha, hg⟩

/-- Named remainder after threading the walk sample: IO coins, goodness
flags, compiler/interpolation backend, and `Inputs.memoryWalkAlpha`. -/
theorem inputsOfWalkSample_preserves_named {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    (inputsOfWalkSample I a g).stateTagChar = I.stateTagChar ∧
      (inputsOfWalkSample I a g).memoryWalkAlpha = I.memoryWalkAlpha ∧
      (inputsOfWalkSample I a g).hOrb = I.hOrb ∧
      (inputsOfWalkSample I a g).basis = I.basis ∧
      (inputsOfWalkSample I a g).orbit = I.orbit ∧
      (inputsOfWalkSample I a g).ioCoins = I.ioCoins ∧
      (inputsOfWalkSample I a g).computeChallenges = I.computeChallenges ∧
      (inputsOfWalkSample I a g).memoryScalarChallenge =
        I.memoryScalarChallenge ∧
      (inputsOfWalkSample I a g).memoryExtensionFold = I.memoryExtensionFold :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- Cubic-fold hypotheses transport: overlay does not touch folds `9`/`11`. -/
theorem inputsOfWalkSample_preserves_cubic {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    (inputsOfWalkSample I a g).computeChallenges =
        I.computeChallenges :=
  rfl

/-- Fold-`2` overlay and walk-sample overlay commute. -/
theorem inputsOfWalkSample_commutes_fold2 {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    inputsOfWalkSample (inputsFold2 I) a g =
      inputsFold2 (inputsOfWalkSample I a g) :=
  rfl

/-- Chip zero-endpoint family reads the overlaid walk sample. -/
theorem zeroEndpointFamily_of_walk_sample {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    (zeroEndpointFamily E (inputsOfWalkSample I a g)).computeWalkAlpha = a ∧
      (zeroEndpointFamily E (inputsOfWalkSample I a g)).walkGamma = g :=
  ⟨rfl, rfl⟩

/-- Exact family completion preserves those walk coins under endpoint
replacement -/
theorem exactFamilyCompletion_of_walk_sample {E : BuildableNockExecution F K}
    (I : Inputs E) (a g : K) :
    (exactFamilyCompletion E (inputsOfWalkSample I a g)).family.computeWalkAlpha =
        a ∧
      (exactFamilyCompletion E (inputsOfWalkSample I a g)).family.walkGamma = g :=
  ⟨rfl, rfl⟩

/-- Additive package constructor at the same walk sample the fibre already
quantifies.  Does not change `packageOf`'s existing signature. -/
def packageOfWalkSample {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ := by claim_generated)
    (hF : GeneratedField.PrimeFieldElems F := by prime_field_elems)
    (a g : K)
    (hordA : 2 ≤ E.cfg.compRows → E.cfg.compRows ≤ orderOf a) :
    OptimizedFullStrictNockVMROMPackage F K I.hOrb :=
  packageOf D hgt (inputsOfWalkSample I a g) hprl hmore
    (fun hrows => by simpa [inputsOfWalkSample] using hordA hrows)
    (fun hrows => by simpa [inputsOfWalkSample] using hordM hrows) hrows hgenF hF

theorem packageOfWalkSample_eq {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (a g : K)
    (hordA : 2 ≤ E.cfg.compRows → E.cfg.compRows ≤ orderOf a) :
    packageOfWalkSample D hgt I hprl hmore hord hordM hrows hgenF hF a g hordA =
      packageOf D hgt (inputsOfWalkSample I a g) hprl hmore
        (fun hrows => by simpa [inputsOfWalkSample] using hordA hrows)
        (fun hrows => by simpa [inputsOfWalkSample] using hordM hrows) hrows hgenF hF :=
  rfl

/-- Constructed sampled assignment sits at the overlaid walk sample. -/
theorem packageOfWalkSample_sampled_reads_walk_pair
    {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F)
    (a g : K)
    (hordA : 2 ≤ E.cfg.compRows → E.cfg.compRows ≤ orderOf a) :
    (packageOfWalkSample D hgt I hprl hmore hord hordM hrows hgenF hF a g hordA).optimized.sampled =
        sampledAssignment E (inputsOfWalkSample I a g) ∧
