def fold2Challenges : FinalComputeChallengeTuple K := default

/-- Every
other field is unchanged, including `hOrb` -/
def inputsFold2 {E : BuildableNockExecution F K} (I : Inputs E) : Inputs E :=
  I.withComputeChallenges fold2Challenges

theorem inputsFold2_zero_cubic {E : BuildableNockExecution F K} (I : Inputs E) :
    (inputsFold2 I).computeChallenges = (default : FinalComputeChallengeTuple K) :=
  rfl

theorem inputsFold2_hOrb {E : BuildableNockExecution F K} (I : Inputs E) :
    (inputsFold2 I).hOrb = I.hOrb :=
  rfl

theorem fold2Challenges_eq_hzero :
    fold2Challenges = (default : FinalComputeChallengeTuple K) :=
  rfl

/-- The collapse stated generally: a compute tuple with both cubic folds at `0` is the zero pair. -/
theorem zero_cubic_is_hzero (c : FinalComputeChallengeTuple K) :
    c = ⟨c.eqA, c.eqB, c.eqC⟩ :=
  FinalComputeChallengeTuple.eta c

/-! ## Generic-path package from `Data` + paper char + named `Inputs` -/

/-- **Named-premises package constructor.**  Selector slot
`36` is whatever `I` supplies.  Not a universal constructor: `Data E` and
`Inputs E` remain premises -/
def packageOf {E : BuildableNockExecution F K} (D : Data E)
    (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ := by claim_generated)
    (hF : GeneratedField.PrimeFieldElems F := by prime_field_elems) :
    OptimizedFullStrictNockVMROMPackage F K I.hOrb :=
  buildFullPackageWith E I (commitmentResidualOfArrays_of_char D hgt)
    (computeChallenge_pins E I) hprl hmore hord hordM hrows hgenF hF

theorem packageOf_eq_buildFullPackageWith {E : BuildableNockExecution F K}
    (D : Data E) (hgt : 11 < ringChar K) (I : Inputs E)
    (hprl : RowLayout.PairedRecordLayout E.exec)
    (hmore : BuildableAxisWitness.LaterSeedZeros E := by later_seed_zeros)
    (hord : 2 ≤ E.cfg.compRows →
      E.cfg.compRows ≤ orderOf I.computeWalkAlpha)
    (hordM : 2 ≤ E.cfg.memRows →
      E.cfg.memRows ≤ orderOf I.memoryWalkAlpha)
    (hrows : 3 * E.cfg.compRows < ringChar K ∧ E.cfg.memRows < ringChar K)
    (hgenF : GeneratedField.ClaimGenerated K D.skeleton.publicClaim D.Λ)
    (hF : GeneratedField.PrimeFieldElems F) :
    packageOf D hgt I hprl hmore hord hordM hrows hgenF hF =
      buildFullPackageWith E I (commitmentResidualOfArrays_of_char D hgt)
        (computeChallenge_pins E I) hprl hmore hord hordM hrows hgenF hF :=
  rfl

