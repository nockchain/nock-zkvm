/-- Compiled negative: the paper's equality block leaves a removed record's root at `⊥`, so `Vmem` never compares it with an added record's root. -/
theorem verify_child_eqBlk_ignores_mem_root
    (inp : MemoryTable.Inputs K) (p : MemoryTable.Pub K)
    (hst : p.st = MemoryTable.MState.verify_child)
    (h : MemoryTable.eqBlk inp p) (root' : ComputeTable.FP K) :
    MemoryTable.eqBlk inp { p with mem := { p.mem with root := root' } } :=
  GenericHonestData.verify_child_eqBlk_ignores_mem_root inp p hst h root'

/-- The exponent-list layer collapses to the record-list layer exactly under timestamp closure,
so it cannot supply `timestampClosed` without circularity -/
theorem timestampExp_recovers_ts_iff_closed (α ts : K) :
    α ^ timestampExp α ts = ts ↔ TimestampClosedAt α ts :=
  GenericHonestData.timestampExp_recovers_ts_iff_closed α ts

