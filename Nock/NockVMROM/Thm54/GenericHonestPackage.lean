/-- F73 fibre `α = 4` is nonzero, so a zero timestamp is not a closed
power.  Reconstructing it yields `1`, not `0`.  Fixture `data73` still
inhabits the extra on its own honest rows; this does not discharge the
generic named premise -/
theorem f73_zero_not_timestampClosed :
    ¬ MemoryTimestampClosedAt concreteExecution.cfg.challenges.α 0 ∧
      concreteExecution.cfg.challenges.α ^
        timestampExp concreteExecution.cfg.challenges.α 0 = 1 := by
  have hα : concreteExecution.cfg.challenges.α = (4 : K73cubic) := rfl
  have h4 : (4 : K73cubic) ≠ 0 := by
    intro h0
    have hbase : (4 : F73) ≠ 0 := by decide
    exact hbase ((algebraMap F73 K73cubic).injective
      (by simpa [map_ofNat, map_zero] using h0))
  rw [hα]
  exact ⟨(reconstructed_power_ne_zero_timestamp h4).2.1,
    (reconstructed_power_ne_zero_timestamp h4).1⟩

/-- F73 first compute row has `ln_prev = 1` -/
theorem f73_firstLine_is_one :
    FirstLineStartsAtOne concreteExecution.exec ∧
      (concreteExecution.exec.computePubAt
        ⟨0, concreteExecution.cfg.compRows_pos⟩).ln_prev = 1 := by
  let i0 : Fin (cfg honestSeed honestAlpha).compRows := ⟨0, by norm_num [cfg]⟩
  have hzero : (exec honestSeed honestAlpha).computePubAt i0 =
      computePub honestSeed honestAlpha := computePubAt_zero
  have hi :
      (⟨0, concreteExecution.cfg.compRows_pos⟩ :
        Fin (cfg honestSeed honestAlpha).compRows) = i0 := Fin.ext rfl
  have hpub :
      concreteExecution.exec.computePubAt
          ⟨0, concreteExecution.cfg.compRows_pos⟩ =
        computePub honestSeed honestAlpha := by
    simpa [concreteExecution, hi] using hzero
  constructor
  · unfold FirstLineStartsAtOne
    rw [hpub]
    rfl
  · rw [hpub]
    rfl

/-- F73 walk overlay at sampled α `4` has `ln(1)=4`, while compute
`ln_prev=1`.  Distinct endpoints -/
theorem f73_walk_overlay_ln1_ne_firstLine :
    (sampledAssignment concreteExecution (inputs73Walk (4 : K73cubic) 0)).exact.computeWalk.ln 1 =
        (4 : K73cubic) ∧
      (concreteExecution.exec.computePubAt
        ⟨0, concreteExecution.cfg.compRows_pos⟩).ln_prev = 1 ∧
      (4 : K73cubic) ≠ 1 := by
  refine ⟨?ln1, f73_firstLine_is_one.2, ?hne⟩
  · change
        (sampledAssignment concreteExecution
            (inputsOfWalkSample inputs73Fold2 (4 : K73cubic) 0)).exact.computeWalk.ln 1 =
          (4 : K73cubic)
    exact sampled_walk_overlay_ln1 inputs73Fold2 (4 : K73cubic) 0
  · intro h
    have hmap :
        algebraMap F73 K73cubic (4 : F73) =
          algebraMap F73 K73cubic (1 : F73) := by
      calc
        algebraMap F73 K73cubic (4 : F73) = (4 : K73cubic) :=
          map_natCast (algebraMap F73 K73cubic) 4
        _ = 1 := h
        _ = algebraMap F73 K73cubic (1 : F73) := by simp
    exact (by decide : (4 : F73) ≠ 1)
      ((algebraMap F73 K73cubic).injective hmap)

/-- Walk RAP `ln(1)=α` coexists with compute `ln_prev=2≠1` on an accepted
OP1 row.  WalkSat does not pin `firstLine` -/
theorem f73_walkSat_and_vcomp_do_not_pin_firstLine :
    ComputeTable.Vcomp (computeInputs honestSeed honestAlpha)
      { computePub honestSeed honestAlpha with
        ln_prev := 2
        ln := 2 * honestAlpha
        mr1 := { (computePub honestSeed honestAlpha).mr1 with
          ts := 2 * honestAlpha } }
      (computeDec honestSeed) ∧
    (2 : K73cubic) ≠ 1 ∧
    ∃ ln count acc : ℕ → K73cubic,
      Nock.Walk.WalkSat (fun _ => 0) (fun _ _ => 0) (fun _ => 0)
        ln count acc honestAlpha 0 0 1 ∧
      ln 1 = honestAlpha := by
  refine ⟨GenericHonestCommitment.Concrete.f73_vcomp_accepts_nonzero_first_ln_prev.1,
    GenericHonestCommitment.Concrete.f73_vcomp_accepts_nonzero_first_ln_prev.2, ?_⟩
  obtain ⟨ln, count, acc, hw⟩ :=
    Nock.Walk.walkSat_exists (fun _ => (0 : K73cubic)) (fun _ _ => 0)
      (fun _ => 0) honestAlpha 0 0 (h := 1) (by norm_num)
  exact ⟨ln, count, acc, hw, hw.ln1⟩

/-- F73 already-held `11 < ringChar` is about `K`, not `E.q = char`. -/
theorem f73_already_held_eleven_lt :
    11 < ringChar K73cubic :=
  f73_char_gt_eleven

/-- F73 execution already carries the inequality -/
theorem f73_already_held_q_le :
    1 < concreteExecution.q ∧ concreteExecution.q ≤ ringChar K73cubic :=
  execution_already_held_is_q_le concreteExecution

/-- Package pin is `|F|=p=char(K)`, not NPR `|K|=p³`. -/
theorem f73_package_pin_is_base_card_not_extension_card :
    Fintype.card F73 = ringChar K73cubic ∧
      Fintype.card K73cubic ≠ ringChar K73cubic :=
  ⟨GenericHonestCommitment.Concrete.f73_base_card_eq_ringChar,
    GenericHonestCommitment.Concrete.f73_cubic_card_ne_ringChar⟩

/-- F73 equality is the constructor choice `q := 73`.  `E`'s type still
allows a strict bound compatible with `11 < char` -/
theorem f73_q_pin_is_constructor_choice :
    concreteExecution.q = 73 ∧
      concreteExecution.q = ringChar K73cubic ∧
      concreteExecution.q ≤ ringChar K73cubic :=
  GenericHonestCommitment.Concrete.f73_q_pin_is_constructor_choice

/-- Strict `q < char` is compatible with already-held `11 < ringChar`. -/
theorem f73_strict_q_compatible_with_eleven_lt :
    11 < ringChar K73cubic ∧
      ∃ q : ℕ, 1 < q ∧ q ≤ ringChar K73cubic ∧ q ≠ ringChar K73cubic :=
  ⟨f73_already_held_eleven_lt,
    GenericHonestCommitment.Concrete.f73_strict_q_le_inhabited⟩

