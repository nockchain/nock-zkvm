/-! ## The `intermediate` accumulator is derived on `E`; the residual is one inclusion

Derived, not assumed:
the whole ordered `intermediate` accumulator with both global zero boundaries and its record-level mass balance.  Not
derived: the record permutation itself, whose paper upgrade is `Thm:IO_result` through the `F(X, Y)` LDSE-to-MSE step.  The
residual reduces to the paper's single inclusion at the paper, and that reduction is an
equivalence.  `PairedRecordLayout` and `timestampClosed` both stay named;
`ForestExponentOrder` is untouched. -/

/-- Derived on `E`: the paper's ordered `intermediate` accumulator, zero to zero. -/
theorem execution_interChain (E : BuildableNockExecution F K) :
    MemoryTable.InterChain E.cfg.challenges.memoryInputs 0 0
      (GenericHonestData.memoryPubRows E.exec) :=
  GenericHonestData.execution_interChain E

/-- Derived on `E`: the added and consumed record lists carry equal LogUp mass. -/
theorem execution_logup_mass_balanced (E : BuildableNockExecution F K) :
    (((memoryPubRows E.exec).filter
        (fun p => decide (p.st = MemoryTable.MState.read_root))).map
        (fun p => (MemoryTable.pole E.cfg.challenges.memoryInputs p.mem p.cprime)⁻¹)).sum
      = (((memoryPubRows E.exec).filter
            (fun p => decide (p.st = MemoryTable.MState.verify_child))).map
          (fun p => (MemoryTable.pole E.cfg.challenges.memoryInputs p.mem p.cprime)⁻¹)).sum :=
  GenericHonestData.execution_logup_mass_balanced E

/-- Already held on `E` under honest `ver`: the added record list is repeat-free. -/
theorem addedRecordList_nodup (E : BuildableNockExecution F K)
    (hhon : ∀ row ∈ E.exec.memoryRows,
      row.2.2.ver = decide (row.2.2.st = MemoryTable.MState.read_root))
    (hC : E.exec.CprimeCoherent) :
    (RowLayout.addedRecordList E.exec).Nodup :=
  GenericHonestData.addedRecordList_nodup E hhon hC

/-- Already held on `E`: the two record lists have equal length. -/
theorem consumed_length_eq_added_length (E : BuildableNockExecution F K) :
    (RowLayout.consumedRecordList E.exec).length
      = (RowLayout.addedRecordList E.exec).length :=
  GenericHonestData.consumed_length_eq_added_length E

/-- The single remaining hypothesis, unfolded: the paper's "removed again". -/
theorem addedRemovedAgain_is_added_subset_consumed
    {cfg : ExactConfig F K} (exec : ExactExecution cfg) :
    GenericHonestData.AddedRemovedAgain exec =
      ∀ r ∈ RowLayout.addedRecordList exec, r ∈ RowLayout.consumedRecordList exec :=
  rfl

/-- The reduction: `PairedRecordLayout` from the paper's single inclusion plus objects already
on `E` and honest `ver` -/
theorem pairedRecordLayout_of_addedRemovedAgain (E : BuildableNockExecution F K)
    (hhon : ∀ row ∈ E.exec.memoryRows,
      row.2.2.ver = decide (row.2.2.st = MemoryTable.MState.read_root))
    (hC : E.exec.CprimeCoherent)
    (h : GenericHonestData.AddedRemovedAgain E.exec) :
    RowLayout.PairedRecordLayout E.exec :=
  GenericHonestData.pairedRecordLayout_of_addedRemovedAgain E hhon hC h

/-- The reduction is an equivalence at `E` under honest `ver`. -/
theorem addedRemovedAgain_iff_pairedRecordLayout (E : BuildableNockExecution F K)
    (hhon : ∀ row ∈ E.exec.memoryRows,
      row.2.2.ver = decide (row.2.2.st = MemoryTable.MState.read_root))
    (hC : E.exec.CprimeCoherent) :
    GenericHonestData.AddedRemovedAgain E.exec ↔ RowLayout.PairedRecordLayout E.exec :=
  GenericHonestData.addedRemovedAgain_iff_pairedRecordLayout E hhon hC

/-- `timestampClosed` through the already-compiled bridge, from the sharpened hypothesis.
The hypothesis is still an extra binder -/
theorem timestampClosed_of_addedRemovedAgain (E : BuildableNockExecution F K)
    (hhon : ∀ row ∈ E.exec.memoryRows,
      row.2.2.ver = decide (row.2.2.st = MemoryTable.MState.read_root))
