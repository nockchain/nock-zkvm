import Nock.NockVMROM.Thm54.RawTopologyRAP
import Nock.NockVMROM.Thm54.TraceEncoding
import Nock.NockVMROM.Thm54.TemplateRawJointSoundness

/-!
# Ordinary segmented AIR for raw topology binding

This file transcribes `TopologyCompressedCheck` to two ordinary kind-segmented RAPs under the
production **verifier-generated trace** architecture.  The prover commits only raw child payload
arrays.  The verifier deterministically constructs every other column from the phase-fixed `R`,
inserts those arrays, interpolates the trace, and evaluates the segmented RAPs.

The lookup is not circular:

* expected payload columns come from the committed parent BFS row;
* prover payload columns are the only raw auxiliary data;
* the verifier first constructs the authoritative aggregate BFS forest, then reads the child row
  at `firstCF(rootCount, fo, parent) + slot`.

The fanout columns are bounded state-derived tags, not free state-selector columns.  Since the
verifier generates them from the committed row state, adding prover-controlled state selectors
would only recreate the all-zero ambiguity quarantined below.

Row constraints bind prover data to that indexed row coordinate-by-coordinate, then compare it
with the parent payload through the sampled `gamma` RLC.  The public
`exact_bfsForest_child_pos` theorem proves that the indexed BFS row is the actual `NTree` child.
No topology predicate is used by soundness.  Because lookup is deterministic and ordered, no
permutation accumulator or extra random challenge is required.

The deep `computeAIR` / `memoryAIR` objects remain exportable backend syntax, but they are
deliberately quarantined from arbitrary prover traces: their all-zero trace satisfies every
constraint.  Production soundness below is exported only for traces generated by
`computeTopologyTrace` / `memoryTopologyTrace` from committed payload arrays.
-/

namespace Nock.NockVMROM.Thm54

open Classical
open Nock Nock.Walk
open Nock.Framework Nock.Framework.Reify Nock.Framework.Thm54
open Nock.Reified
open scoped Polynomial

noncomputable section

variable {F K : Type} [Field F] [Field K] [Algebra F K]
variable {p : ℕ} [CharP K p]

set_option maxRecDepth 200000

/-! ## Canonical BFS accessors and raw prover arrays -/

@[simp] theorem computeWalkRows_length (R : RawPlusIOSegmentedFamily F K) :
    R.computeWalkRows.length = R.cfg.compRows := by
  simpa [RawPlusIOSegmentedFamily.computeWalkRows] using R.exec.compute_bfs_length

@[simp] theorem memoryWalkRows_length (R : RawPlusIOSegmentedFamily F K) :
    R.memoryWalkRows.length = R.cfg.memRows := by
  simpa [RawPlusIOSegmentedFamily.memoryWalkRows] using R.exec.memory_bfs_length

def computeTopologyNodeAt (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) :
    NTree (ComputeTable.State × ComputeTable.DTcomp K) :=
  R.computeWalkRows.get (Fin.cast (computeWalkRows_length R).symm i)

def memoryTopologyNodeAt (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) :
    NTree (MemoryTable.MState × MemoryTable.DTmem K) :=
  R.memoryWalkRows.get (Fin.cast (memoryWalkRows_length R).symm i)

def computeTopologyActive (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) (slot : Fin 3) : K :=
  if (slot : ℕ) < ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1 then 1 else 0

def memoryTopologyActive (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) (slot : Fin 2) : K :=
  if (slot : ℕ) < MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1 then 1 else 0

/-- One-based canonical BFS child-row index for a compute parent/slot. -/
def computeExpectedChildIndex (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) (slot : Fin 3) : ℕ :=
  firstCF 1 (foCol R.computeWalkRows) ((i : ℕ) + 1) + slot

/-- One-based canonical BFS child-row index for a memory parent/slot. -/
def memoryExpectedChildIndex (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) (slot : Fin 2) : ℕ :=
  firstCF R.exec.memoryForest.length (foCol R.memoryWalkRows) ((i : ℕ) + 1) + slot

def computeLookupNode (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) (slot : Fin 3) :
    NTree (ComputeTable.State × ComputeTable.DTcomp K) :=
  R.computeWalkRows.getD (computeExpectedChildIndex R i slot - 1) R.exec.computeTree

def memoryLookupNode (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) (slot : Fin 2) :
    NTree (MemoryTable.MState × MemoryTable.DTmem K) :=
  R.memoryWalkRows.getD (memoryExpectedChildIndex R i slot - 1)
    (R.exec.memoryForest.get
      ⟨0, List.length_pos_of_ne_nil R.exec.memoryForest_nonempty⟩)

def computeLookupPayload (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) (slot : Fin 3) : ComputeLinkPayload K :=
  let pub := (computeLookupNode R i slot).label.2.2.1
  ⟨pub.s, pub.f, pub.e⟩

def memoryLookupPayload (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) (slot : Fin 2) : MemoryTable.Cell K :=
  (memoryLookupNode R i slot).label.2.2.pt

/-- The only compute-side prover data: child payloads committed before `gamma`. -/
structure RawComputeTopologyArrays (R : RawPlusIOSegmentedFamily F K) where
  childPayload : Fin R.cfg.compRows → Fin 3 → ComputeLinkPayload K

/-- The only memory-side prover data: child payloads committed before `gamma`. -/
structure RawMemoryTopologyArrays (R : RawPlusIOSegmentedFamily F K) where
  childPayload : Fin R.cfg.memRows → Fin 2 → MemoryTable.Cell K

structure RawTopologyArrays (R : RawPlusIOSegmentedFamily F K) where
  compute : RawComputeTopologyArrays R
  memory : RawMemoryTopologyArrays R

/-- Topology arrays committed in the NPR-seed phase.  Their type mentions only `C.base`, so neither
`gamma` nor either alpha challenge is available when these functions are chosen. -/
structure RawTopologySeedArrays {claim : P8PublicClaim} {z : K}
    (C : RawP8SeedCommitment (F := F) (K := K) claim z p) where
  computeChildPayload : Fin C.base.cfg.compRows → Fin 3 → ComputeLinkPayload K
  memoryChildPayload : Fin C.base.cfg.memRows → Fin 2 → MemoryTable.Cell K

/-- Exact extension point for the old raw strategy: one seed commitment stores both the existing
raw data and topology payload arrays before any later challenge is supplied. -/
structure RawP8SeedCommitmentWithTopology
    (claim : P8PublicClaim) (z : K) (p : ℕ) where
  raw : RawP8SeedCommitment (F := F) (K := K) claim z p
  topology : RawTopologySeedArrays raw

/-- After challenges are sampled, reinterpret the already-committed arrays at the resulting raw
family.  This function inserts no challenge into an array coordinate. -/
def RawTopologySeedArrays.atJointCoins
    {claim : P8PublicClaim} {z : K}
    {C : RawP8SeedCommitment (F := F) (K := K) claim z p}
    (A : RawTopologySeedArrays C) (ω : JointCoins K) :
    RawTopologyArrays (C.atJointCoins ω) where
  compute :=
    { childPayload := A.computeChildPayload }
  memory :=
    { childPayload := A.memoryChildPayload }

theorem RawTopologySeedArrays.payloads_independent_of_jointCoins
    {claim : P8PublicClaim} {z : K}
    {C : RawP8SeedCommitment (F := F) (K := K) claim z p}
    (A : RawTopologySeedArrays C) (ω₁ ω₂ : JointCoins K) :
    (∀ i slot,
      (A.atJointCoins ω₁).compute.childPayload i slot =
        (A.atJointCoins ω₂).compute.childPayload i slot) ∧
    (∀ i slot,
      (A.atJointCoins ω₁).memory.childPayload i slot =
        (A.atJointCoins ω₂).memory.childPayload i slot) := by
  exact ⟨fun _ _ => rfl, fun _ _ => rfl⟩

/-- Template-strategy topology arrays committed with the `(z, alphaM)` commitment.  The structure
has no `alphaC` or `gamma` argument, so payload arrays are fixed before the topology challenge. -/
structure TemplateTopologyAlphaMArrays
    {T : SemanticTimestampStrategy.DataOnlyTemplateFixedStagedTimestampStrategy
      (F := F) (K := K)}
    {z : K} {hz : z ≠ 0} {alphaM lmb : K}
    (C : TemplateRawJointSoundness.AlphaMCommitment (p := p) T z hz alphaM lmb) where
  computeChildPayload :
    Fin C.familyData.base.cfg.compRows → Fin 3 → ComputeLinkPayload K
  memoryChildPayload :
    Fin C.familyData.base.cfg.memRows → Fin 2 → MemoryTable.Cell K

/-- Exact extension point for the template strategy: the existing alpha-M commitment and topology
payload arrays are stored together before `(alphaC,gamma)` are available. -/
structure TemplateAlphaMCommitmentWithTopology
    (T : SemanticTimestampStrategy.DataOnlyTemplateFixedStagedTimestampStrategy
      (F := F) (K := K))
    (z : K) (hz : z ≠ 0) (alphaM lmb : K) (p : ℕ) where
  raw : TemplateRawJointSoundness.AlphaMCommitment (p := p) T z hz alphaM lmb
  topology : TemplateTopologyAlphaMArrays raw

/-- Reinterpret the `(z, alphaM)`-committed payloads after later `(alphaC, gamma)` sampling.
Neither later coin is inspected to produce an array value. -/
def TemplateTopologyAlphaMArrays.atCoins
    {T : SemanticTimestampStrategy.DataOnlyTemplateFixedStagedTimestampStrategy
      (F := F) (K := K)}
    {z : K} {hz : z ≠ 0} {alphaM lmb : K}
    {C : TemplateRawJointSoundness.AlphaMCommitment (p := p) T z hz alphaM lmb}
    (A : TemplateTopologyAlphaMArrays C) (alphaC gamma : K) :
    RawTopologyArrays (C.familyData.atCoins alphaC gamma) where
  compute := { childPayload := A.computeChildPayload }
  memory := { childPayload := A.memoryChildPayload }

theorem TemplateTopologyAlphaMArrays.payloads_independent_of_laterCoins
    {T : SemanticTimestampStrategy.DataOnlyTemplateFixedStagedTimestampStrategy
      (F := F) (K := K)}
    {z : K} {hz : z ≠ 0} {alphaM lmb : K}
    {C : TemplateRawJointSoundness.AlphaMCommitment (p := p) T z hz alphaM lmb}
    (A : TemplateTopologyAlphaMArrays C)
    (alphaC₁ gamma₁ alphaC₂ gamma₂ : K) :
    (∀ i slot,
      (A.atCoins alphaC₁ gamma₁).compute.childPayload i slot =
        (A.atCoins alphaC₂ gamma₂).compute.childPayload i slot) ∧
    (∀ i slot,
      (A.atCoins alphaC₁ gamma₁).memory.childPayload i slot =
        (A.atCoins alphaC₂ gamma₂).memory.childPayload i slot) := by
  exact ⟨fun _ _ => rfl, fun _ _ => rfl⟩

/-! ## Deep AIR schemas -/

namespace RawTopologyAIR

abbrev computeSlotWidth : ℕ := 28
abbrev computeTraceWidth : ℕ := 86
abbrev memorySlotWidth : ℕ := 16
abbrev memoryTraceWidth : ℕ := 34

def computeBase (slot : Fin 3) : ℕ := 2 + (slot : ℕ) * computeSlotWidth
def computeActiveCol (slot : Fin 3) : ℕ := computeBase slot
def computeExpectedPayloadCol (slot : Fin 3) (c : Fin 9) : ℕ :=
  computeBase slot + 1 + c
def computeActualPayloadCol (slot : Fin 3) (c : Fin 9) : ℕ :=
  computeBase slot + 10 + c
def computeLookupPayloadCol (slot : Fin 3) (c : Fin 9) : ℕ :=
  computeBase slot + 19 + c

def memoryBase (slot : Fin 2) : ℕ := 2 + (slot : ℕ) * memorySlotWidth
def memoryActiveCol (slot : Fin 2) : ℕ := memoryBase slot
def memoryExpectedPayloadCol (slot : Fin 2) (c : Fin 5) : ℕ :=
  memoryBase slot + 1 + c
def memoryActualPayloadCol (slot : Fin 2) (c : Fin 5) : ℕ :=
  memoryBase slot + 6 + c
def memoryLookupPayloadCol (slot : Fin 2) (c : Fin 5) : ℕ :=
  memoryBase slot + 11 + c

def vcur (i : ℕ) : Expr := .Var .traceCur i
def gammaE : Expr := .Var .challenge 0

def sumExpr : List Expr → Expr
  | [] => .Const 0
  | e :: es => .Add e (sumExpr es)

def rlcDiffExpr (width actualBase expectedBase : ℕ) : Expr :=
  sumExpr ((List.range width).map fun c =>
    .Mul (.Pow gammaE c)
      (.Sub (vcur (actualBase + c)) (vcur (expectedBase + c))))

def activeGate (active : ℕ) (e : Expr) : Expr := .Mul (vcur active) e

def fanoutExpr : Expr := .Sub (vcur 0) (vcur 1)
def activeBoolExpr (active : ℕ) : Expr :=
  .Mul (vcur active) (.Sub (.Const 1) (vcur active))

def computeSlotConstraints (slot : Fin 3) : List Constraint :=
  [⟨.row, activeBoolExpr (computeActiveCol slot)⟩] ++
  (List.ofFn fun c : Fin 9 =>
    (⟨.row, activeGate (computeActiveCol slot)
      (.Sub (vcur (computeActualPayloadCol slot c))
        (vcur (computeLookupPayloadCol slot c)))⟩ : Constraint)) ++
  [⟨.row, activeGate (computeActiveCol slot)
    (rlcDiffExpr 9 (computeActualPayloadCol slot 0)
      (computeExpectedPayloadCol slot 0))⟩]

def memorySlotConstraints (slot : Fin 2) : List Constraint :=
  [⟨.row, activeBoolExpr (memoryActiveCol slot)⟩] ++
  (List.ofFn fun c : Fin 5 =>
    (⟨.row, activeGate (memoryActiveCol slot)
      (.Sub (vcur (memoryActualPayloadCol slot c))
        (vcur (memoryLookupPayloadCol slot c)))⟩ : Constraint)) ++
  [⟨.row, activeGate (memoryActiveCol slot)
    (rlcDiffExpr 5 (memoryActualPayloadCol slot 0)
      (memoryExpectedPayloadCol slot 0))⟩]

def computeAIR : AIR where
  numTraceCols := computeTraceWidth
  numChallenges := 1
  numPublic := 0
  constraints := [⟨.row, fanoutExpr⟩] ++
    (List.ofFn computeSlotConstraints).flatten

def memoryAIR : AIR where
  numTraceCols := memoryTraceWidth
  numChallenges := 1
  numPublic := 0
  constraints := [⟨.row, fanoutExpr⟩] ++
    (List.ofFn memorySlotConstraints).flatten

theorem computeAIR_numTraceCols : computeAIR.numTraceCols = 86 := rfl
theorem memoryAIR_numTraceCols : memoryAIR.numTraceCols = 34 := rfl
theorem computeAIR_constraint_count : computeAIR.constraints.length = 34 := by decide
theorem memoryAIR_constraint_count : memoryAIR.constraints.length = 15 := by decide
theorem computeAIR_maxDegree : computeAIR.maxDegree = 2 := by decide
theorem memoryAIR_maxDegree : memoryAIR.maxDegree = 2 := by decide

end RawTopologyAIR

/-! ## Concrete rows and interpolated traces -/

def computeTopologyTraceVal (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i : Fin R.cfg.compRows) (col : ℕ) : K :=
  if col = 0 then computeActualFanoutTag (computeTopologyNodeAt R i)
  else if col = 1 then computeExpectedFanoutTag (computeTopologyNodeAt R i)
  else
    let q := col - 2
    let sn := q / RawTopologyAIR.computeSlotWidth
    let off := q % RawTopologyAIR.computeSlotWidth
    if hs : sn < 3 then
      let slot : Fin 3 := ⟨sn, hs⟩
      if off = 0 then computeTopologyActive R i slot
      else if hE : off < 10 then
        ComputeLinkPayload.encode (computeExpectedPayload (computeTopologyNodeAt R i) slot)
          ⟨off - 1, by omega⟩
      else if hA : off < 19 then
        ComputeLinkPayload.encode (A.childPayload i slot) ⟨off - 10, by omega⟩
      else if hL : off < 28 then
        ComputeLinkPayload.encode (computeLookupPayload R i slot) ⟨off - 19, by omega⟩
      else 0
    else 0

def memoryTopologyTraceVal (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i : Fin R.cfg.memRows) (col : ℕ) : K :=
  if col = 0 then memoryActualFanoutTag (memoryTopologyNodeAt R i)
  else if col = 1 then memoryExpectedFanoutTag (memoryTopologyNodeAt R i)
  else
    let q := col - 2
    let sn := q / RawTopologyAIR.memorySlotWidth
    let off := q % RawTopologyAIR.memorySlotWidth
    if hs : sn < 2 then
      let slot : Fin 2 := ⟨sn, hs⟩
      if off = 0 then memoryTopologyActive R i slot
      else if hE : off < 6 then
        MemoryLinkPayload.encode (memoryExpectedPayload (memoryTopologyNodeAt R i) slot)
          ⟨off - 1, by omega⟩
      else if hA : off < 11 then
        MemoryLinkPayload.encode (A.childPayload i slot) ⟨off - 6, by omega⟩
      else if hL : off < 16 then
        MemoryLinkPayload.encode (memoryLookupPayload R i slot) ⟨off - 11, by omega⟩
      else 0
    else 0

def computeTopologyRowEnv (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i : Fin R.cfg.compRows) : Env K where
  trace := computeTopologyTraceVal R A i
  traceNext := fun _ => 0
  chal := fun
    | 0 => R.walkGamma
    | _ => 0
  pub := fun _ => 0

def memoryTopologyRowEnv (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i : Fin R.cfg.memRows) : Env K where
  trace := memoryTopologyTraceVal R A i
  traceNext := fun _ => 0
  chal := fun
    | 0 => R.walkGamma
    | _ => 0
  pub := fun _ => 0

namespace RawTopologyAIR

@[simp] theorem computeRow_fanoutActual (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) :
    (computeTopologyRowEnv R A i).trace 0 =
      computeActualFanoutTag (computeTopologyNodeAt R i) := rfl

@[simp] theorem computeRow_fanoutExpected (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) :
    (computeTopologyRowEnv R A i).trace 1 =
      computeExpectedFanoutTag (computeTopologyNodeAt R i) := rfl

@[simp] theorem computeRow_active (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) (slot : Fin 3) :
    (computeTopologyRowEnv R A i).trace (computeActiveCol slot) =
      computeTopologyActive R i slot := by
  fin_cases slot <;> rfl

@[simp] theorem computeRow_expectedPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) (slot : Fin 3) (c : Fin 9) :
    (computeTopologyRowEnv R A i).trace (computeExpectedPayloadCol slot c) =
      ComputeLinkPayload.encode
        (computeExpectedPayload (computeTopologyNodeAt R i) slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

@[simp] theorem computeRow_actualPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) (slot : Fin 3) (c : Fin 9) :
    (computeTopologyRowEnv R A i).trace (computeActualPayloadCol slot c) =
      ComputeLinkPayload.encode (A.childPayload i slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

@[simp] theorem computeRow_lookupPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) (i) (slot : Fin 3) (c : Fin 9) :
    (computeTopologyRowEnv R A i).trace (computeLookupPayloadCol slot c) =
      ComputeLinkPayload.encode (computeLookupPayload R i slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

@[simp] theorem memoryRow_fanoutActual (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) :
    (memoryTopologyRowEnv R A i).trace 0 =
      memoryActualFanoutTag (memoryTopologyNodeAt R i) := rfl

@[simp] theorem memoryRow_fanoutExpected (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) :
    (memoryTopologyRowEnv R A i).trace 1 =
      memoryExpectedFanoutTag (memoryTopologyNodeAt R i) := rfl

@[simp] theorem memoryRow_active (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) (slot : Fin 2) :
    (memoryTopologyRowEnv R A i).trace (memoryActiveCol slot) =
      memoryTopologyActive R i slot := by
  fin_cases slot <;> rfl

@[simp] theorem memoryRow_expectedPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) (slot : Fin 2) (c : Fin 5) :
    (memoryTopologyRowEnv R A i).trace (memoryExpectedPayloadCol slot c) =
      MemoryLinkPayload.encode
        (memoryExpectedPayload (memoryTopologyNodeAt R i) slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

@[simp] theorem memoryRow_actualPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) (slot : Fin 2) (c : Fin 5) :
    (memoryTopologyRowEnv R A i).trace (memoryActualPayloadCol slot c) =
      MemoryLinkPayload.encode (A.childPayload i slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

@[simp] theorem memoryRow_lookupPayload (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) (i) (slot : Fin 2) (c : Fin 5) :
    (memoryTopologyRowEnv R A i).trace (memoryLookupPayloadCol slot c) =
      MemoryLinkPayload.encode (memoryLookupPayload R i slot) c := by
  fin_cases slot <;> fin_cases c <;> rfl

end RawTopologyAIR

noncomputable def computeTopologyTrace (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) :
    Fin RawTopologyAIR.computeAIR.numTraceCols → K[X] :=
  encodeEnvTrace (computeTopologyRowEnv R A) R.cfg.compNodes

noncomputable def memoryTopologyTrace (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) :
    Fin RawTopologyAIR.memoryAIR.numTraceCols → K[X] :=
  encodeEnvTrace (memoryTopologyRowEnv R A) R.cfg.memNodes

def topologyChallengeValuation (γ : K) : ℕ → K
  | 0 => γ
  | _ => 0

/-- Quarantined generic backend RAP.  It is not a production arbitrary-trace interface. -/
noncomputable def computeTopologyGenericRAP (R : RawPlusIOSegmentedFamily F K)
    (kind : ConstraintKind) : RAP K :=
  airToRAP (kindSeg RawTopologyAIR.computeAIR kind)
    (topologyChallengeValuation R.walkGamma) (fun _ => 0)
    R.cfg.eDeg R.cfg.orbit.h R.cfg.orbit.ω R.cfg.orbit.βcoset
    (R.cfg.computeDomain kind) R.cfg.orbit.βcoset_ne_zero R.cfg.orbit_h_pos

/-- Quarantined generic backend RAP.  It is not a production arbitrary-trace interface. -/
noncomputable def memoryTopologyGenericRAP (R : RawPlusIOSegmentedFamily F K)
    (kind : ConstraintKind) : RAP K :=
  airToRAP (kindSeg RawTopologyAIR.memoryAIR kind)
    (topologyChallengeValuation R.walkGamma) (fun _ => 0)
    R.cfg.eDeg R.cfg.orbit.h R.cfg.orbit.ω R.cfg.orbit.βcoset
    (R.cfg.memoryDomain kind) R.cfg.orbit.βcoset_ne_zero R.cfg.orbit_h_pos

/-- Production satisfaction: RAPs are evaluated only on verifier-generated traces obtained by
inserting phase-committed payload arrays into deterministic columns derived from `R`. -/
def VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays
    (R : RawPlusIOSegmentedFamily F K)
    (A : RawTopologyArrays R) : Prop :=
  (∀ kind, (computeTopologyGenericRAP R kind).Satisfies
      (computeTopologyTrace R A.compute)) ∧
    (∀ kind, (memoryTopologyGenericRAP R kind).Satisfies
      (memoryTopologyTrace R A.memory))

namespace RawTopologyAIR

theorem computeAIR_all_row :
    computeAIR.constraints.all (fun c => c.kind == .row) = true := by decide

theorem memoryAIR_all_row :
    memoryAIR.constraints.all (fun c => c.kind == .row) = true := by decide

theorem computeAIR_wellScoped :
    computeAIR.constraints.all
      (fun c => c.expr.wellScoped computeAIR.numTraceCols) = true := by decide

theorem memoryAIR_wellScoped :
    memoryAIR.constraints.all
      (fun c => c.expr.wellScoped memoryAIR.numTraceCols) = true := by decide

/-! ### Quarantine regression for arbitrary polynomial traces -/

noncomputable def computeAllZeroArbitraryTrace :
    Fin computeAIR.numTraceCols → K[X] := fun _ => 0

noncomputable def memoryAllZeroArbitraryTrace :
    Fin memoryAIR.numTraceCols → K[X] := fun _ => 0

private theorem compute_constraint_zero_of_trace_zero
    (env : Env K) (hz : ∀ j, env.trace j = 0)
    (c : Constraint) (hc : c ∈ computeAIR.constraints) :
    c.expr.eval env = 0 := by
  change c ∈ [⟨.row, fanoutExpr⟩] ++
    (List.ofFn computeSlotConstraints).flatten at hc
  rw [List.mem_append] at hc
  rcases hc with hc | hc
  · simp at hc
    subst c
    simp [fanoutExpr, vcur, Expr.eval, hz]
  · obtain ⟨cs, hcs, hcin⟩ := List.mem_flatten.mp hc
    obtain ⟨slot, rfl⟩ := List.mem_ofFn.mp hcs
    change c ∈
      [⟨.row, activeBoolExpr (computeActiveCol slot)⟩] ++
      (List.ofFn fun q : Fin 9 =>
        (⟨.row, activeGate (computeActiveCol slot)
          (.Sub (vcur (computeActualPayloadCol slot q))
            (vcur (computeLookupPayloadCol slot q)))⟩ : Constraint)) ++
      [⟨.row, activeGate (computeActiveCol slot)
        (rlcDiffExpr 9 (computeActualPayloadCol slot 0)
          (computeExpectedPayloadCol slot 0))⟩] at hcin
    simp only [List.mem_append] at hcin
    rcases hcin with hnonrlc | hrlc
    · rcases hnonrlc with hactive | hlookup
      · simp at hactive
        subst c
        simp [activeBoolExpr, vcur, Expr.eval, hz]
      · obtain ⟨q, rfl⟩ := List.mem_ofFn.mp hlookup
        simp [activeGate, vcur, Expr.eval, hz]
    · simp at hrlc
      subst c
      simp [activeGate, vcur, Expr.eval, hz]

private theorem memory_constraint_zero_of_trace_zero
    (env : Env K) (hz : ∀ j, env.trace j = 0)
    (c : Constraint) (hc : c ∈ memoryAIR.constraints) :
    c.expr.eval env = 0 := by
  change c ∈ [⟨.row, fanoutExpr⟩] ++
    (List.ofFn memorySlotConstraints).flatten at hc
  rw [List.mem_append] at hc
  rcases hc with hc | hc
  · simp at hc
    subst c
    simp [fanoutExpr, vcur, Expr.eval, hz]
  · obtain ⟨cs, hcs, hcin⟩ := List.mem_flatten.mp hc
    obtain ⟨slot, rfl⟩ := List.mem_ofFn.mp hcs
    change c ∈
      [⟨.row, activeBoolExpr (memoryActiveCol slot)⟩] ++
      (List.ofFn fun q : Fin 5 =>
        (⟨.row, activeGate (memoryActiveCol slot)
          (.Sub (vcur (memoryActualPayloadCol slot q))
            (vcur (memoryLookupPayloadCol slot q)))⟩ : Constraint)) ++
      [⟨.row, activeGate (memoryActiveCol slot)
        (rlcDiffExpr 5 (memoryActualPayloadCol slot 0)
          (memoryExpectedPayloadCol slot 0))⟩] at hcin
    simp only [List.mem_append] at hcin
    rcases hcin with hnonrlc | hrlc
    · rcases hnonrlc with hactive | hlookup
      · simp at hactive
        subst c
        simp [activeBoolExpr, vcur, Expr.eval, hz]
      · obtain ⟨q, rfl⟩ := List.mem_ofFn.mp hlookup
        simp [activeGate, vcur, Expr.eval, hz]
    · simp at hrlc
      subst c
      simp [activeGate, vcur, Expr.eval, hz]

end RawTopologyAIR

/-- Critical regression: the generic deep AIRs accept an arbitrary all-zero polynomial trace.
Therefore no theorem below exports soundness for a prover-supplied topology trace. -/
theorem allZero_generic_satisfies (R : RawPlusIOSegmentedFamily F K) :
    (∀ kind, (computeTopologyGenericRAP R kind).Satisfies
      (RawTopologyAIR.computeAllZeroArbitraryTrace (K := K))) ∧
    (∀ kind, (memoryTopologyGenericRAP R kind).Satisfies
      (RawTopologyAIR.memoryAllZeroArbitraryTrace (K := K))) := by
  constructor
  · intro kind
    unfold computeTopologyGenericRAP
    erw [airToRAP_satisfies_iff]
    intro x hx c hc
    simp only [kindSeg, List.mem_filter] at hc
    apply RawTopologyAIR.compute_constraint_zero_of_trace_zero
      (envOfTrace (RawTopologyAIR.computeAllZeroArbitraryTrace (K := K))
        R.cfg.orbit.ω x (topologyChallengeValuation R.walkGamma) (fun _ => 0))
    · intro j
      simp [envOfTrace, RawTopologyAIR.computeAllZeroArbitraryTrace]
    · exact hc.1
  · intro kind
    unfold memoryTopologyGenericRAP
    erw [airToRAP_satisfies_iff]
    intro x hx c hc
    simp only [kindSeg, List.mem_filter] at hc
    apply RawTopologyAIR.memory_constraint_zero_of_trace_zero
      (envOfTrace (RawTopologyAIR.memoryAllZeroArbitraryTrace (K := K))
        R.cfg.orbit.ω x (topologyChallengeValuation R.walkGamma) (fun _ => 0))
    · intro j
      simp [envOfTrace, RawTopologyAIR.memoryAllZeroArbitraryTrace]
    · exact hc.1

def ComputeTopologyRowsVanish (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) : Prop :=
  ∀ i, ∀ c ∈ RawTopologyAIR.computeAIR.constraints,
    c.expr.eval (computeTopologyRowEnv R A i) = 0

def MemoryTopologyRowsVanish (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) : Prop :=
  ∀ i, ∀ c ∈ RawTopologyAIR.memoryAIR.constraints,
    c.expr.eval (memoryTopologyRowEnv R A i) = 0

private theorem compute_encoded_eval_eq_row
    (R : RawPlusIOSegmentedFamily F K) (A : RawComputeTopologyArrays R)
    (i : Fin R.cfg.compRows) (c : Constraint)
    (hc : c ∈ RawTopologyAIR.computeAIR.constraints) :
    c.expr.eval
      (envOfTrace (computeTopologyTrace R A) R.cfg.orbit.ω (R.cfg.compNodes i)
        (topologyChallengeValuation R.walkGamma) (fun _ => 0)) =
      c.expr.eval (computeTopologyRowEnv R A i) := by
  apply Expr.eval_eq_of_wellScoped
    ((List.all_eq_true.mp RawTopologyAIR.computeAIR_wellScoped) c hc)
  · intro j hj
    simp only [envOfTrace, dif_pos hj]
    exact encodeEnvTrace_eval_at_node (computeTopologyRowEnv R A) R.cfg.compNodes
      R.cfg.compNodes_injective i ⟨j, hj⟩
  · intro j
    cases j <;> rfl
  · intro j
    rfl

private theorem memory_encoded_eval_eq_row
    (R : RawPlusIOSegmentedFamily F K) (A : RawMemoryTopologyArrays R)
    (i : Fin R.cfg.memRows) (c : Constraint)
    (hc : c ∈ RawTopologyAIR.memoryAIR.constraints) :
    c.expr.eval
      (envOfTrace (memoryTopologyTrace R A) R.cfg.orbit.ω (R.cfg.memNodes i)
        (topologyChallengeValuation R.walkGamma) (fun _ => 0)) =
      c.expr.eval (memoryTopologyRowEnv R A i) := by
  apply Expr.eval_eq_of_wellScoped
    ((List.all_eq_true.mp RawTopologyAIR.memoryAIR_wellScoped) c hc)
  · intro j hj
    simp only [envOfTrace, dif_pos hj]
    exact encodeEnvTrace_eval_at_node (memoryTopologyRowEnv R A) R.cfg.memNodes
      R.cfg.memNodes_injective i ⟨j, hj⟩
  · intro j
    cases j <;> rfl
  · intro j
    rfl

theorem computeVerifierGeneratedTopologyRAP_iff_rowsVanish
    (R : RawPlusIOSegmentedFamily F K) (A : RawComputeTopologyArrays R) :
    (∀ kind, (computeTopologyGenericRAP R kind).Satisfies
      (computeTopologyTrace R A)) ↔
      ComputeTopologyRowsVanish R A := by
  unfold computeTopologyGenericRAP
  rw [segmented_is_kinded]
  constructor
  · intro h i c hc
    have hkind : c.kind = .row := by
      have := (List.all_eq_true.mp RawTopologyAIR.computeAIR_all_row) c hc
      simpa using this
    have hx : R.cfg.compNodes i ∈ R.cfg.computeDomain c.kind := by
      rw [hkind, R.cfg.computeRowDomain_eq_nodes]
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
    rw [← compute_encoded_eval_eq_row R A i c hc]
    exact h c hc (R.cfg.compNodes i) hx
  · intro h c hc x hx
    have hkind : c.kind = .row := by
      have := (List.all_eq_true.mp RawTopologyAIR.computeAIR_all_row) c hc
      simpa using this
    rw [hkind, R.cfg.computeRowDomain_eq_nodes] at hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    rw [compute_encoded_eval_eq_row R A i c hc]
    exact h i c hc

theorem memoryVerifierGeneratedTopologyRAP_iff_rowsVanish
    (R : RawPlusIOSegmentedFamily F K) (A : RawMemoryTopologyArrays R) :
    (∀ kind, (memoryTopologyGenericRAP R kind).Satisfies
      (memoryTopologyTrace R A)) ↔
      MemoryTopologyRowsVanish R A := by
  unfold memoryTopologyGenericRAP
  rw [segmented_is_kinded]
  constructor
  · intro h i c hc
    have hkind : c.kind = .row := by
      have := (List.all_eq_true.mp RawTopologyAIR.memoryAIR_all_row) c hc
      simpa using this
    have hx : R.cfg.memNodes i ∈ R.cfg.memoryDomain c.kind := by
      rw [hkind, R.cfg.memoryRowDomain_eq_nodes]
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
    rw [← memory_encoded_eval_eq_row R A i c hc]
    exact h c hc (R.cfg.memNodes i) hx
  · intro h c hc x hx
    have hkind : c.kind = .row := by
      have := (List.all_eq_true.mp RawTopologyAIR.memoryAIR_all_row) c hc
      simpa using this
    rw [hkind, R.cfg.memoryRowDomain_eq_nodes] at hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    rw [memory_encoded_eval_eq_row R A i c hc]
    exact h i c hc

theorem verifierGeneratedTopologyRAP_iff_rowsVanish
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R) :
    VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A ↔
      ComputeTopologyRowsVanish R A.compute ∧
        MemoryTopologyRowsVanish R A.memory := by
  exact and_congr
    (computeVerifierGeneratedTopologyRAP_iff_rowsVanish R A.compute)
    (memoryVerifierGeneratedTopologyRAP_iff_rowsVanish R A.memory)

/-! ## Decoding row constraints -/

namespace RawTopologyAIR

def rlcRange (γ : K) (width : ℕ) (v : ℕ → K) : K :=
  ((List.range width).map fun c => γ ^ c * v c).sum

theorem sumExpr_eval (env : Env K) (es : List Expr) :
    (sumExpr es).eval env = (es.map fun e => e.eval env).sum := by
  induction es with
  | nil => simp [sumExpr, Expr.eval]
  | cons e es ih => simp [sumExpr, Expr.eval, ih]

theorem rlcDiffExpr_eval (env : Env K) (width actualBase expectedBase : ℕ) :
    (rlcDiffExpr width actualBase expectedBase).eval env =
      rlcRange (env.chal 0) width
        (fun c => env.trace (actualBase + c) - env.trace (expectedBase + c)) := by
  rw [rlcDiffExpr, sumExpr_eval]
  simp only [List.map_map, Function.comp_apply, Expr.eval]
  rfl

theorem rlcRange_eq_fin (γ : K) (width : ℕ) (v : ℕ → K) :
    rlcRange γ width v = ∑ c : Fin width, γ ^ (c : ℕ) * v c := by
  unfold rlcRange
  rw [← List.sum_toFinset _ List.nodup_range]
  rw [List.toFinset_range]
  simpa using (Fin.sum_univ_eq_sum_range
    (fun c : ℕ => γ ^ c * v c) width).symm

theorem rlcRange_nine_eq (γ : K) (u v : Fin 9 → K) :
    rlcRange γ 9 (fun c => if h : c < 9 then u ⟨c, h⟩ - v ⟨c, h⟩ else 0) =
      rlc γ u - rlc γ v := by
  rw [rlcRange_eq_fin]
  simp only [rlc]
  simp_rw [dif_pos (Fin.isLt _), mul_sub]
  rw [Finset.sum_sub_distrib]

theorem rlcRange_five_eq (γ : K) (u v : Fin 5 → K) :
    rlcRange γ 5 (fun c => if h : c < 5 then u ⟨c, h⟩ - v ⟨c, h⟩ else 0) =
      rlc γ u - rlc γ v := by
  rw [rlcRange_eq_fin]
  simp only [rlc]
  simp_rw [dif_pos (Fin.isLt _), mul_sub]
  rw [Finset.sum_sub_distrib]

end RawTopologyAIR

def ComputeTopologyFieldChecks (R : RawPlusIOSegmentedFamily F K)
    (A : RawComputeTopologyArrays R) : Prop :=
  ∀ i : Fin R.cfg.compRows,
    computeActualFanoutTag (computeTopologyNodeAt R i) =
        computeExpectedFanoutTag (computeTopologyNodeAt R i) ∧
      ∀ slot : Fin 3,
        (slot : ℕ) < ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1 →
          (∀ c : Fin 9,
            ComputeLinkPayload.encode (A.childPayload i slot) c =
              ComputeLinkPayload.encode (computeLookupPayload R i slot) c) ∧
          rlc R.walkGamma (ComputeLinkPayload.encode (A.childPayload i slot)) =
            rlc R.walkGamma (ComputeLinkPayload.encode
              (computeExpectedPayload (computeTopologyNodeAt R i) slot))

def MemoryTopologyFieldChecks (R : RawPlusIOSegmentedFamily F K)
    (A : RawMemoryTopologyArrays R) : Prop :=
  ∀ i : Fin R.cfg.memRows,
    memoryActualFanoutTag (memoryTopologyNodeAt R i) =
        memoryExpectedFanoutTag (memoryTopologyNodeAt R i) ∧
      ∀ slot : Fin 2,
        (slot : ℕ) < MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1 →
          (∀ c : Fin 5,
            MemoryLinkPayload.encode (A.childPayload i slot) c =
              MemoryLinkPayload.encode (memoryLookupPayload R i slot) c) ∧
          rlc R.walkGamma (MemoryLinkPayload.encode (A.childPayload i slot)) =
            rlc R.walkGamma (MemoryLinkPayload.encode
              (memoryExpectedPayload (memoryTopologyNodeAt R i) slot))

namespace RawTopologyAIR

theorem compute_fanout_mem :
    (⟨.row, fanoutExpr⟩ : Constraint) ∈ computeAIR.constraints := by
  simp [computeAIR]

theorem memory_fanout_mem :
    (⟨.row, fanoutExpr⟩ : Constraint) ∈ memoryAIR.constraints := by
  simp [memoryAIR]

theorem compute_lookup_mem (slot : Fin 3) (c : Fin 9) :
    (⟨.row, activeGate (computeActiveCol slot)
      (.Sub (vcur (computeActualPayloadCol slot c))
        (vcur (computeLookupPayloadCol slot c)))⟩ :
        Constraint) ∈ computeAIR.constraints := by
  fin_cases slot <;> fin_cases c <;> simp [computeAIR, computeSlotConstraints]

theorem compute_rlc_mem (slot : Fin 3) :
    (⟨.row, activeGate (computeActiveCol slot)
      (rlcDiffExpr 9 (computeActualPayloadCol slot 0)
        (computeExpectedPayloadCol slot 0))⟩ :
        Constraint) ∈ computeAIR.constraints := by
  fin_cases slot <;> simp [computeAIR, computeSlotConstraints]

theorem memory_lookup_mem (slot : Fin 2) (c : Fin 5) :
    (⟨.row, activeGate (memoryActiveCol slot)
      (.Sub (vcur (memoryActualPayloadCol slot c))
        (vcur (memoryLookupPayloadCol slot c)))⟩ :
        Constraint) ∈ memoryAIR.constraints := by
  fin_cases slot <;> fin_cases c <;> simp [memoryAIR, memorySlotConstraints]

theorem memory_rlc_mem (slot : Fin 2) :
    (⟨.row, activeGate (memoryActiveCol slot)
      (rlcDiffExpr 5 (memoryActualPayloadCol slot 0)
        (memoryExpectedPayloadCol slot 0))⟩ :
        Constraint) ∈ memoryAIR.constraints := by
  fin_cases slot <;> simp [memoryAIR, memorySlotConstraints]

end RawTopologyAIR

theorem computeFieldChecks_of_rowsVanish
    (R : RawPlusIOSegmentedFamily F K) (A : RawComputeTopologyArrays R)
    (h : ComputeTopologyRowsVanish R A) :
    ComputeTopologyFieldChecks R A := by
  intro i
  constructor
  · have hz := h i _ RawTopologyAIR.compute_fanout_mem
    simpa [RawTopologyAIR.fanoutExpr, RawTopologyAIR.vcur, Expr.eval] using
      (sub_eq_zero.mp hz)
  · intro slot hi
    have hactive : computeTopologyActive R i slot = 1 := by
      simp [computeTopologyActive, hi]
    constructor
    · intro c
      have hz := h i _ (RawTopologyAIR.compute_lookup_mem slot c)
      simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
        hactive] at hz
      exact sub_eq_zero.mp hz
    · have hz := h i _ (RawTopologyAIR.compute_rlc_mem slot)
      simp only [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
        RawTopologyAIR.computeRow_active, hactive, one_mul] at hz
      rw [RawTopologyAIR.rlcDiffExpr_eval] at hz
      have hrange :
          RawTopologyAIR.rlcRange R.walkGamma 9 (fun c =>
            if hc : c < 9 then
              ComputeLinkPayload.encode (A.childPayload i slot) ⟨c, hc⟩ -
                ComputeLinkPayload.encode
                  (computeExpectedPayload (computeTopologyNodeAt R i) slot) ⟨c, hc⟩
            else 0) = 0 := by
        rw [RawTopologyAIR.rlcRange_eq_fin] at hz ⊢
        have hactual (c : Fin 9) :
            (computeTopologyRowEnv R A i).trace
                (RawTopologyAIR.computeActualPayloadCol slot 0 + (c : ℕ)) =
              ComputeLinkPayload.encode (A.childPayload i slot) c := by
          simpa [RawTopologyAIR.computeActualPayloadCol, Nat.add_assoc] using
            RawTopologyAIR.computeRow_actualPayload R A i slot c
        have hexpected (c : Fin 9) :
            (computeTopologyRowEnv R A i).trace
                (RawTopologyAIR.computeExpectedPayloadCol slot 0 + (c : ℕ)) =
              ComputeLinkPayload.encode
                (computeExpectedPayload (computeTopologyNodeAt R i) slot) c := by
          simpa [RawTopologyAIR.computeExpectedPayloadCol, Nat.add_assoc] using
            RawTopologyAIR.computeRow_expectedPayload R A i slot c
        simp_rw [hactual, hexpected] at hz
        simpa [computeTopologyRowEnv, topologyChallengeValuation] using hz
      rw [RawTopologyAIR.rlcRange_nine_eq] at hrange
      exact sub_eq_zero.mp hrange

theorem memoryFieldChecks_of_rowsVanish
    (R : RawPlusIOSegmentedFamily F K) (A : RawMemoryTopologyArrays R)
    (h : MemoryTopologyRowsVanish R A) :
    MemoryTopologyFieldChecks R A := by
  intro i
  constructor
  · have hz := h i _ RawTopologyAIR.memory_fanout_mem
    simpa [RawTopologyAIR.fanoutExpr, RawTopologyAIR.vcur, Expr.eval] using
      (sub_eq_zero.mp hz)
  · intro slot hi
    have hactive : memoryTopologyActive R i slot = 1 := by
      simp [memoryTopologyActive, hi]
    constructor
    · intro c
      have hz := h i _ (RawTopologyAIR.memory_lookup_mem slot c)
      simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
        hactive] at hz
      exact sub_eq_zero.mp hz
    · have hz := h i _ (RawTopologyAIR.memory_rlc_mem slot)
      simp only [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
        RawTopologyAIR.memoryRow_active, hactive, one_mul] at hz
      rw [RawTopologyAIR.rlcDiffExpr_eval] at hz
      have hrange :
          RawTopologyAIR.rlcRange R.walkGamma 5 (fun c =>
            if hc : c < 5 then
              MemoryLinkPayload.encode (A.childPayload i slot) ⟨c, hc⟩ -
                MemoryLinkPayload.encode
                  (memoryExpectedPayload (memoryTopologyNodeAt R i) slot) ⟨c, hc⟩
            else 0) = 0 := by
        rw [RawTopologyAIR.rlcRange_eq_fin] at hz ⊢
        have hactual (c : Fin 5) :
            (memoryTopologyRowEnv R A i).trace
                (RawTopologyAIR.memoryActualPayloadCol slot 0 + (c : ℕ)) =
              MemoryLinkPayload.encode (A.childPayload i slot) c := by
          simpa [RawTopologyAIR.memoryActualPayloadCol, Nat.add_assoc] using
            RawTopologyAIR.memoryRow_actualPayload R A i slot c
        have hexpected (c : Fin 5) :
            (memoryTopologyRowEnv R A i).trace
                (RawTopologyAIR.memoryExpectedPayloadCol slot 0 + (c : ℕ)) =
              MemoryLinkPayload.encode
                (memoryExpectedPayload (memoryTopologyNodeAt R i) slot) c := by
          simpa [RawTopologyAIR.memoryExpectedPayloadCol, Nat.add_assoc] using
            RawTopologyAIR.memoryRow_expectedPayload R A i slot c
        simp_rw [hactual, hexpected] at hz
        simpa [memoryTopologyRowEnv, topologyChallengeValuation] using hz
      rw [RawTopologyAIR.rlcRange_five_eq] at hrange
      exact sub_eq_zero.mp hrange

private theorem compute_rlc_constraint_eval
    (R : RawPlusIOSegmentedFamily F K) (A : RawComputeTopologyArrays R)
    (i : Fin R.cfg.compRows) (slot : Fin 3) :
    (RawTopologyAIR.activeGate (RawTopologyAIR.computeActiveCol slot)
      (RawTopologyAIR.rlcDiffExpr 9
        (RawTopologyAIR.computeActualPayloadCol slot 0)
        (RawTopologyAIR.computeExpectedPayloadCol slot 0))).eval
        (computeTopologyRowEnv R A i) =
      computeTopologyActive R i slot *
        (rlc R.walkGamma (ComputeLinkPayload.encode (A.childPayload i slot)) -
          rlc R.walkGamma (ComputeLinkPayload.encode
            (computeExpectedPayload (computeTopologyNodeAt R i) slot))) := by
  simp only [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
    RawTopologyAIR.computeRow_active]
  rw [RawTopologyAIR.rlcDiffExpr_eval, RawTopologyAIR.rlcRange_eq_fin]
  have hactual (c : Fin 9) :
      (computeTopologyRowEnv R A i).trace
          (RawTopologyAIR.computeActualPayloadCol slot 0 + (c : ℕ)) =
        ComputeLinkPayload.encode (A.childPayload i slot) c := by
    simpa [RawTopologyAIR.computeActualPayloadCol, Nat.add_assoc] using
      RawTopologyAIR.computeRow_actualPayload R A i slot c
  have hexpected (c : Fin 9) :
      (computeTopologyRowEnv R A i).trace
          (RawTopologyAIR.computeExpectedPayloadCol slot 0 + (c : ℕ)) =
        ComputeLinkPayload.encode
          (computeExpectedPayload (computeTopologyNodeAt R i) slot) c := by
    simpa [RawTopologyAIR.computeExpectedPayloadCol, Nat.add_assoc] using
      RawTopologyAIR.computeRow_expectedPayload R A i slot c
  simp_rw [hactual, hexpected]
  simp only [computeTopologyRowEnv, topologyChallengeValuation]
  rw [← RawTopologyAIR.rlcRange_nine_eq]
  rw [RawTopologyAIR.rlcRange_eq_fin]
  simp

private theorem memory_rlc_constraint_eval
    (R : RawPlusIOSegmentedFamily F K) (A : RawMemoryTopologyArrays R)
    (i : Fin R.cfg.memRows) (slot : Fin 2) :
    (RawTopologyAIR.activeGate (RawTopologyAIR.memoryActiveCol slot)
      (RawTopologyAIR.rlcDiffExpr 5
        (RawTopologyAIR.memoryActualPayloadCol slot 0)
        (RawTopologyAIR.memoryExpectedPayloadCol slot 0))).eval
        (memoryTopologyRowEnv R A i) =
      memoryTopologyActive R i slot *
        (rlc R.walkGamma (MemoryLinkPayload.encode (A.childPayload i slot)) -
          rlc R.walkGamma (MemoryLinkPayload.encode
            (memoryExpectedPayload (memoryTopologyNodeAt R i) slot))) := by
  simp only [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
    RawTopologyAIR.memoryRow_active]
  rw [RawTopologyAIR.rlcDiffExpr_eval, RawTopologyAIR.rlcRange_eq_fin]
  have hactual (c : Fin 5) :
      (memoryTopologyRowEnv R A i).trace
          (RawTopologyAIR.memoryActualPayloadCol slot 0 + (c : ℕ)) =
        MemoryLinkPayload.encode (A.childPayload i slot) c := by
    simpa [RawTopologyAIR.memoryActualPayloadCol, Nat.add_assoc] using
      RawTopologyAIR.memoryRow_actualPayload R A i slot c
  have hexpected (c : Fin 5) :
      (memoryTopologyRowEnv R A i).trace
          (RawTopologyAIR.memoryExpectedPayloadCol slot 0 + (c : ℕ)) =
        MemoryLinkPayload.encode
          (memoryExpectedPayload (memoryTopologyNodeAt R i) slot) c := by
    simpa [RawTopologyAIR.memoryExpectedPayloadCol, Nat.add_assoc] using
      RawTopologyAIR.memoryRow_expectedPayload R A i slot c
  simp_rw [hactual, hexpected]
  simp only [memoryTopologyRowEnv, topologyChallengeValuation]
  rw [← RawTopologyAIR.rlcRange_five_eq]
  rw [RawTopologyAIR.rlcRange_eq_fin]
  simp

theorem computeRowsVanish_of_fieldChecks
    (R : RawPlusIOSegmentedFamily F K) (A : RawComputeTopologyArrays R)
    (h : ComputeTopologyFieldChecks R A) :
    ComputeTopologyRowsVanish R A := by
  intro i c hc
  change c ∈ [⟨.row, RawTopologyAIR.fanoutExpr⟩] ++
    (List.ofFn RawTopologyAIR.computeSlotConstraints).flatten at hc
  rw [List.mem_append] at hc
  rcases hc with hc | hc
  · simp only [List.mem_singleton] at hc
    subst c
    simp [RawTopologyAIR.fanoutExpr, RawTopologyAIR.vcur, Expr.eval, (h i).1]
  · obtain ⟨cs, hcs, hcin⟩ := List.mem_flatten.mp hc
    obtain ⟨slot, rfl⟩ := List.mem_ofFn.mp hcs
    change c ∈
      [⟨.row, RawTopologyAIR.activeBoolExpr
          (RawTopologyAIR.computeActiveCol slot)⟩] ++
      (List.ofFn fun q : Fin 9 =>
        (⟨.row, RawTopologyAIR.activeGate (RawTopologyAIR.computeActiveCol slot)
          (.Sub (RawTopologyAIR.vcur (RawTopologyAIR.computeActualPayloadCol slot q))
            (RawTopologyAIR.vcur (RawTopologyAIR.computeLookupPayloadCol slot q)))⟩ :
          Constraint)) ++
      [⟨.row, RawTopologyAIR.activeGate (RawTopologyAIR.computeActiveCol slot)
        (RawTopologyAIR.rlcDiffExpr 9
          (RawTopologyAIR.computeActualPayloadCol slot 0)
          (RawTopologyAIR.computeExpectedPayloadCol slot 0))⟩] at hcin
    simp only [List.mem_append] at hcin
    rcases hcin with hnonrlc | hrlc
    · rcases hnonrlc with hhead | hlookup
      · simp at hhead
        subst c
        by_cases hi : (slot : ℕ) <
          ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1
        <;> simp [RawTopologyAIR.activeBoolExpr, RawTopologyAIR.vcur, Expr.eval,
          computeTopologyActive, hi]
      · obtain ⟨q, rfl⟩ := List.mem_ofFn.mp hlookup
        by_cases hi : (slot : ℕ) <
            ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1
        · simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
            computeTopologyActive, hi, ((h i).2 slot hi).1 q]
        · simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
            computeTopologyActive, hi]
    · simp at hrlc
      subst c
      rw [compute_rlc_constraint_eval]
      by_cases hi : (slot : ℕ) <
          ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1
      · simp [computeTopologyActive, hi, ((h i).2 slot hi).2]
      · simp [computeTopologyActive, hi]

theorem memoryRowsVanish_of_fieldChecks
    (R : RawPlusIOSegmentedFamily F K) (A : RawMemoryTopologyArrays R)
    (h : MemoryTopologyFieldChecks R A) :
    MemoryTopologyRowsVanish R A := by
  intro i c hc
  change c ∈ [⟨.row, RawTopologyAIR.fanoutExpr⟩] ++
    (List.ofFn RawTopologyAIR.memorySlotConstraints).flatten at hc
  rw [List.mem_append] at hc
  rcases hc with hc | hc
  · simp only [List.mem_singleton] at hc
    subst c
    simp [RawTopologyAIR.fanoutExpr, RawTopologyAIR.vcur, Expr.eval, (h i).1]
  · obtain ⟨cs, hcs, hcin⟩ := List.mem_flatten.mp hc
    obtain ⟨slot, rfl⟩ := List.mem_ofFn.mp hcs
    change c ∈
      [⟨.row, RawTopologyAIR.activeBoolExpr
          (RawTopologyAIR.memoryActiveCol slot)⟩] ++
      (List.ofFn fun q : Fin 5 =>
        (⟨.row, RawTopologyAIR.activeGate (RawTopologyAIR.memoryActiveCol slot)
          (.Sub (RawTopologyAIR.vcur (RawTopologyAIR.memoryActualPayloadCol slot q))
            (RawTopologyAIR.vcur (RawTopologyAIR.memoryLookupPayloadCol slot q)))⟩ :
          Constraint)) ++
      [⟨.row, RawTopologyAIR.activeGate (RawTopologyAIR.memoryActiveCol slot)
        (RawTopologyAIR.rlcDiffExpr 5
          (RawTopologyAIR.memoryActualPayloadCol slot 0)
          (RawTopologyAIR.memoryExpectedPayloadCol slot 0))⟩] at hcin
    simp only [List.mem_append] at hcin
    rcases hcin with hnonrlc | hrlc
    · rcases hnonrlc with hhead | hlookup
      · simp at hhead
        subst c
        by_cases hi : (slot : ℕ) <
          MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1
        <;> simp [RawTopologyAIR.activeBoolExpr, RawTopologyAIR.vcur, Expr.eval,
          memoryTopologyActive, hi]
      · obtain ⟨q, rfl⟩ := List.mem_ofFn.mp hlookup
        by_cases hi : (slot : ℕ) <
            MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1
        · simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
            memoryTopologyActive, hi, ((h i).2 slot hi).1 q]
        · simp [RawTopologyAIR.activeGate, RawTopologyAIR.vcur, Expr.eval,
            memoryTopologyActive, hi]
    · simp at hrlc
      subst c
      rw [memory_rlc_constraint_eval]
      by_cases hi : (slot : ℕ) <
          MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1
      · simp [memoryTopologyActive, hi, ((h i).2 slot hi).2]
      · simp [memoryTopologyActive, hi]

theorem verifierGeneratedTopologyRAP_iff_fieldChecksOfCommittedArrays
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R) :
    VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A ↔
      ComputeTopologyFieldChecks R A.compute ∧
        MemoryTopologyFieldChecks R A.memory := by
  rw [verifierGeneratedTopologyRAP_iff_rowsVanish]
  constructor
  · rintro ⟨hc, hm⟩
    exact ⟨computeFieldChecks_of_rowsVanish R A.compute hc,
      memoryFieldChecks_of_rowsVanish R A.memory hm⟩
  · rintro ⟨hc, hm⟩
    exact ⟨computeRowsVanish_of_fieldChecks R A.compute hc,
      memoryRowsVanish_of_fieldChecks R A.memory hm⟩

/-! ## The indexed lookup is the authoritative child row -/

theorem computeLookupNode_eq_child
    (R : RawPlusIOSegmentedFamily F K) (i : Fin R.cfg.compRows) (slot : Fin 3)
    (hi : (slot : ℕ) < (computeTopologyNodeAt R i).children.length) :
    computeLookupNode R i slot =
      (computeTopologyNodeAt R i).children.get ⟨slot, hi⟩ := by
  let W := R.computeWalkRows
  let t := computeTopologyNodeAt R i
  let child := t.children.get ⟨slot, hi⟩
  have hW : W = bfsForest [R.exec.computeTree] := rfl
  have hparent : W[((i : ℕ) + 1) - 1]? = some t := by
    simp [W, t, computeTopologyNodeAt, List.getElem?_eq_getElem]
  have hparent0 : W[(i : ℕ)]? = some t := by
    simpa using hparent
  have hfo : foCol W ((i : ℕ) + 1) = t.children.length := by
    simp [foCol, hparent0]
  have hj : (slot : ℕ) < foCol W ((i : ℕ) + 1) := by
    rw [hfo]
    exact hi
  have hj' : (slot : ℕ) <
      foCol (bfsForest [R.exec.computeTree]) ((i : ℕ) + 1) := by
    rw [← hW]
    exact hj
  have hp := exact_bfsForest_child_pos [R.exec.computeTree] (by simp)
    (i := (i : ℕ) + 1) (j := slot) (by omega) hj'
  have hpW :
      W[firstCF 1 (foCol W) ((i : ℕ) + 1) + slot - 1]? =
        W[(i : ℕ)]?.bind (fun a => a.children[(slot : ℕ)]?) := by
    rw [hW]
    exact hp
  rw [hparent0] at hpW
  simp only [Option.bind_some] at hpW
  have hchild : t.children[(slot : ℕ)]? = some child := by
    simp [child, List.getElem?_eq_getElem hi]
  rw [hchild] at hpW
  have hpos :
      W[computeExpectedChildIndex R i slot - 1]? = some child := by
    simpa [W, computeExpectedChildIndex, child,
      List.getElem?_eq_getElem hi] using hpW
  unfold computeLookupNode
  rw [List.getD_eq_getElem?_getD, hpos]
  rfl

theorem memoryLookupNode_eq_child
    (R : RawPlusIOSegmentedFamily F K) (i : Fin R.cfg.memRows) (slot : Fin 2)
    (hi : (slot : ℕ) < (memoryTopologyNodeAt R i).children.length) :
    memoryLookupNode R i slot =
      (memoryTopologyNodeAt R i).children.get ⟨slot, hi⟩ := by
  let W := R.memoryWalkRows
  let t := memoryTopologyNodeAt R i
  let child := t.children.get ⟨slot, hi⟩
  have hW : W = bfsForest R.exec.memoryForest := rfl
  have hparent : W[((i : ℕ) + 1) - 1]? = some t := by
    simp [W, t, memoryTopologyNodeAt, List.getElem?_eq_getElem]
  have hparent0 : W[(i : ℕ)]? = some t := by
    simpa using hparent
  have hfo : foCol W ((i : ℕ) + 1) = t.children.length := by
    simp [foCol, hparent0]
  have hj : (slot : ℕ) < foCol W ((i : ℕ) + 1) := by
    rw [hfo]
    exact hi
  have hj' : (slot : ℕ) <
      foCol (bfsForest R.exec.memoryForest) ((i : ℕ) + 1) := by
    rw [← hW]
    exact hj
  have hp := exact_bfsForest_child_pos R.exec.memoryForest
    R.exec.memoryForest_nonempty
    (i := (i : ℕ) + 1) (j := slot) (by omega) hj'
  have hpW :
      W[firstCF R.exec.memoryForest.length (foCol W) ((i : ℕ) + 1) + slot - 1]? =
        W[(i : ℕ)]?.bind (fun a => a.children[(slot : ℕ)]?) := by
    rw [hW]
    exact hp
  rw [hparent0] at hpW
  simp only [Option.bind_some] at hpW
  have hchild : t.children[(slot : ℕ)]? = some child := by
    simp [child, List.getElem?_eq_getElem hi]
  rw [hchild] at hpW
  have hpos :
      W[memoryExpectedChildIndex R i slot - 1]? = some child := by
    simpa [W, memoryExpectedChildIndex, child,
      List.getElem?_eq_getElem hi] using hpW
  unfold memoryLookupNode
  rw [List.getD_eq_getElem?_getD, hpos]
  rfl

theorem computeLookupPayload_eq_actual
    (R : RawPlusIOSegmentedFamily F K) (i : Fin R.cfg.compRows) (slot : Fin 3)
    (hi : (slot : ℕ) < (computeTopologyNodeAt R i).children.length) :
    computeLookupPayload R i slot =
      computeActualPayload (computeTopologyNodeAt R i) slot := by
  let child := (computeTopologyNodeAt R i).children.get ⟨slot, hi⟩
  have hchild :
      (computeTopologyNodeAt R i).childLabel slot = some child.label := by
    simp [NTree.childLabel, NTree.childOpt, child, List.getElem?_eq_getElem hi]
  rw [computeLookupPayload, computeLookupNode_eq_child R i slot hi]
  simp [computeActualPayload, hchild, child]

theorem memoryLookupPayload_eq_actual
    (R : RawPlusIOSegmentedFamily F K) (i : Fin R.cfg.memRows) (slot : Fin 2)
    (hi : (slot : ℕ) < (memoryTopologyNodeAt R i).children.length) :
    memoryLookupPayload R i slot =
      memoryActualPayload (memoryTopologyNodeAt R i) slot := by
  let child := (memoryTopologyNodeAt R i).children.get ⟨slot, hi⟩
  have hchild :
      (memoryTopologyNodeAt R i).childLabel slot = some child.label := by
    simp [NTree.childLabel, NTree.childOpt, child, List.getElem?_eq_getElem hi]
  rw [memoryLookupPayload, memoryLookupNode_eq_child R i slot hi]
  simp [memoryActualPayload, hchild, child]

private theorem compute_mem_as_nodeAt
    (R : RawPlusIOSegmentedFamily F K)
    {t : NTree (ComputeTable.State × ComputeTable.DTcomp K)}
    (ht : t ∈ R.computeWalkRows) :
    ∃ i : Fin R.cfg.compRows, computeTopologyNodeAt R i = t := by
  obtain ⟨k, hk, hkt⟩ := List.getElem_of_mem ht
  let i : Fin R.cfg.compRows := ⟨k, by simpa using
    (show k < R.computeWalkRows.length from hk)⟩
  refine ⟨i, ?_⟩
  simpa [computeTopologyNodeAt, i, List.get_eq_getElem] using hkt

private theorem memory_mem_as_nodeAt
    (R : RawPlusIOSegmentedFamily F K)
    {t : NTree (MemoryTable.MState × MemoryTable.DTmem K)}
    (ht : t ∈ R.memoryWalkRows) :
    ∃ i : Fin R.cfg.memRows, memoryTopologyNodeAt R i = t := by
  obtain ⟨k, hk, hkt⟩ := List.getElem_of_mem ht
  let i : Fin R.cfg.memRows := ⟨k, by simpa using
    (show k < R.memoryWalkRows.length from hk)⟩
  refine ⟨i, ?_⟩
  simpa [memoryTopologyNodeAt, i, List.get_eq_getElem] using hkt

theorem topologyCompressedCheck_of_fieldChecks
    (hchar : NodeEncoding.StateTagChar K)
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (hc : ComputeTopologyFieldChecks R A.compute)
    (hm : MemoryTopologyFieldChecks R A.memory) :
    TopologyCompressedCheck R R.walkGamma := by
  constructor
  · intro t ht
    obtain ⟨i, rfl⟩ := compute_mem_as_nodeAt R ht
    refine ⟨(hc i).1, ?_⟩
    intro slot hslot
    have hlen : (slot : ℕ) < (computeTopologyNodeAt R i).children.length := by
      rw [← computeFanout_eq_of_tag_eq hchar _ (hc i).1]
      exact hslot
    have hs := (hc i).2 slot hslot
    have harrayLookup :
        A.compute.childPayload i slot = computeLookupPayload R i slot :=
      ComputeLinkPayload.encode_injective (funext hs.1)
    rw [← computeLookupPayload_eq_actual R i slot hlen, ← harrayLookup]
    exact hs.2
  · intro t ht
    obtain ⟨i, rfl⟩ := memory_mem_as_nodeAt R ht
    refine ⟨(hm i).1, ?_⟩
    intro slot hslot
    have hlen : (slot : ℕ) < (memoryTopologyNodeAt R i).children.length := by
      rw [← memoryFanout_eq_of_tag_eq hchar _ (hm i).1]
      exact hslot
    have hs := (hm i).2 slot hslot
    have harrayLookup :
        A.memory.childPayload i slot = memoryLookupPayload R i slot :=
      MemoryLinkPayload.encode_injective (funext hs.1)
    rw [← memoryLookupPayload_eq_actual R i slot hlen, ← harrayLookup]
    exact hs.2

theorem topologyCompressedCheck_of_verifierGeneratedRAPOfCommittedArrays
    (hchar : NodeEncoding.StateTagChar K)
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (hsat : VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A) :
    TopologyCompressedCheck R R.walkGamma := by
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  exact topologyCompressedCheck_of_fieldChecks hchar R A
    (computeFieldChecks_of_rowsVanish R A.compute hv.1)
    (memoryFieldChecks_of_rowsVanish R A.memory hv.2)

/-! ## Honest prover completeness -/

def honestTopologyArrays (R : RawPlusIOSegmentedFamily F K) : RawTopologyArrays R where
  compute :=
    { childPayload := computeLookupPayload R }
  memory :=
    { childPayload := memoryLookupPayload R }

private theorem computeNodeAt_mem (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.compRows) :
    computeTopologyNodeAt R i ∈ R.computeWalkRows := by
  exact List.get_mem _ _

private theorem memoryNodeAt_mem (R : RawPlusIOSegmentedFamily F K)
    (i : Fin R.cfg.memRows) :
    memoryTopologyNodeAt R i ∈ R.memoryWalkRows := by
  exact List.get_mem _ _

theorem honestTopologyFieldChecks_of_binding
    (R : RawPlusIOSegmentedFamily F K)
    (hbind : RawTopologyBindingResidual R) :
    ComputeTopologyFieldChecks R (honestTopologyArrays R).compute ∧
      MemoryTopologyFieldChecks R (honestTopologyArrays R).memory := by
  constructor
  · intro i
    let t := computeTopologyNodeAt R i
    have hb := hbind.1 t (computeNodeAt_mem R i)
    have hle : t.children.length ≤ 3 := by
      rw [← hb.1]
      exact (ComputeTable.comp_stateSep (K := K)).fanout_le t.label.1
    constructor
    · simp [computeActualFanoutTag, computeExpectedFanoutTag, t, hle, hb.1]
    · intro slot hi
      have hlen : (slot : ℕ) < t.children.length := by
        rw [← hb.1]
        exact hi
      refine ⟨fun _ => rfl, ?_⟩
      have hlookup := computeLookupPayload_eq_actual R i slot hlen
      let child := t.children.get ⟨slot, hlen⟩
      have hchild : t.childLabel slot = some child.label := by
        simp [NTree.childLabel, NTree.childOpt, child, List.getElem?_eq_getElem hlen]
      have hp := hb.2 slot hi
      change (t.childLabel slot).map
        (fun c => (c.2.2.1.s, c.2.2.1.f, c.2.2.1.e)) =
          some (ComputeTable.sfTriple t.label.2.2.1 slot) at hp
      rw [hchild] at hp
      have htriple :
          (child.label.2.2.1.s, child.label.2.2.1.f, child.label.2.2.1.e) =
            ComputeTable.sfTriple t.label.2.2.1 slot := by
        simpa using Option.some.inj hp
      have hpayload :
          computeActualPayload t slot = computeExpectedPayload t slot := by
        rw [computeActualPayload, computeExpectedPayload, hchild]
        simpa [ComputeLinkPayload.ofTriple] using
          congrArg (ComputeLinkPayload.ofTriple (K := K)) htriple
      change rlc R.walkGamma (ComputeLinkPayload.encode (computeLookupPayload R i slot)) =
        rlc R.walkGamma (ComputeLinkPayload.encode
          (computeExpectedPayload (computeTopologyNodeAt R i) slot))
      rw [hlookup, hpayload]
  · intro i
    let t := memoryTopologyNodeAt R i
    have hb := hbind.2 t (memoryNodeAt_mem R i)
    have hle : t.children.length ≤ 2 := by
      rw [← hb.1]
      exact (MemoryTable.mem_stateSep (K := K)).fanout_le t.label.1
    constructor
    · simp [memoryActualFanoutTag, memoryExpectedFanoutTag, t, hle, hb.1]
    · intro slot hi
      have hlen : (slot : ℕ) < t.children.length := by
        rw [← hb.1]
        exact hi
      refine ⟨fun _ => rfl, ?_⟩
      have hlookup := memoryLookupPayload_eq_actual R i slot hlen
      let child := t.children.get ⟨slot, hlen⟩
      have hchild : t.childLabel slot = some child.label := by
        simp [NTree.childLabel, NTree.childOpt, child, List.getElem?_eq_getElem hlen]
      have hp := hb.2 slot hi
      change (t.childLabel slot).map (fun c => c.2.2.pt) =
        some (MemoryTable.memCell t.label slot) at hp
      rw [hchild] at hp
      have hpayload :
          memoryActualPayload t slot = memoryExpectedPayload t slot := by
        simpa [memoryActualPayload, memoryExpectedPayload, hchild] using
          Option.some.inj hp
      change rlc R.walkGamma (MemoryLinkPayload.encode (memoryLookupPayload R i slot)) =
        rlc R.walkGamma (MemoryLinkPayload.encode
          (memoryExpectedPayload (memoryTopologyNodeAt R i) slot))
      rw [hlookup, hpayload]

theorem honestVerifierGeneratedTopologyRAP_complete_of_binding
    (R : RawPlusIOSegmentedFamily F K)
    (hbind : RawTopologyBindingResidual R) :
    VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R
      (honestTopologyArrays R) :=
  (verifierGeneratedTopologyRAP_iff_fieldChecksOfCommittedArrays R
    (honestTopologyArrays R)).2
    (honestTopologyFieldChecks_of_binding R hbind)

theorem honestVerifierGeneratedTopologyRAP_complete
    (R : RawPlusIOSegmentedFamily F K)
    (htop : ComputeExactTopology R.exec ∧ MemoryExactTopology R.exec) :
    VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R
      (honestTopologyArrays R) := by
  apply honestVerifierGeneratedTopologyRAP_complete_of_binding R
  constructor
  · simpa [RawPlusIOSegmentedFamily.computeWalkRows] using
      computeBinding_of_exactTopology htop.1
  · simpa [RawPlusIOSegmentedFamily.memoryWalkRows] using
      memoryBinding_of_exactTopology htop.2

/-! ## End-to-end soundness and regressions -/

theorem RawMessage.exactTopology_of_accepts_and_verifierGeneratedTopologyRAPOfCommittedArrays
    [Fintype K] [DecidableEq K]
    {R : RawPlusIOSegmentedFamily F K}
    {claim : P8PublicClaim} {ω : JointCoins K}
    (M : RawMessage R p) (A : RawTopologyArrays R)
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, (R.exec.memoryPubAt i).lambda = R.cfg.challenges.lam)
    (haccept : M.Accepts claim ω)
    (htop : VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A)
    (hout : gamma ω ∉ topologyBadGammas R) :
    ComputeExactTopology R.exec ∧ MemoryExactTopology R.exec := by
  have hγ : R.walkGamma = gamma ω := haccept.1.2.2.2.1
  apply M.exactTopology_of_accepts_and_compressedCheck hchar hlam haccept
  · simpa [hγ] using
      topologyCompressedCheck_of_verifierGeneratedRAPOfCommittedArrays hchar R A htop
  · exact hout

theorem RawP8Strategy.exactTopology_of_accepts_and_verifierGeneratedTopologyRAPOfCommittedArrays
    [Fintype K] [DecidableEq K]
    (T : RawP8Strategy F K p) (ω : JointCoins K)
    (hz : nprSeed ω ≠ 0)
    (A : RawTopologySeedArrays (T.afterSeed (nprSeed ω) hz))
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, ((T.familyAt ω hz).exec.memoryPubAt i).lambda = (T.familyAt ω hz).cfg.challenges.lam)
    (haccept : T.Accepts ω)
    (htop : VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays
      (T.familyAt ω hz) (A.atJointCoins ω))
    (hout : ω ∉ rawStrategyTopologyFailureEvent T) :
    ComputeExactTopology (T.familyAt ω hz).exec ∧
      MemoryExactTopology (T.familyAt ω hz).exec := by
  have hraw :
      (T.messageAt ω hz).Accepts T.claim ω := by
    simpa [RawP8Strategy.Accepts, hz, RawAccepts, proof_irrel_heq] using haccept
  apply RawMessage.exactTopology_of_accepts_and_verifierGeneratedTopologyRAPOfCommittedArrays
    (T.messageAt ω hz) (A.atJointCoins ω) hchar hlam hraw htop
  intro hbad
  apply hout
  apply (mem_rawStrategyTopologyFailureEvent_iff T ω).2
  refine ⟨hz, ?_⟩
  have hfixed :
      topologyBadGammas ((T.afterSeed (nprSeed ω) hz).atJointCoins ω) =
        topologyBadGammas (T.afterSeed (nprSeed ω) hz).base :=
    rfl
  rw [← hfixed]
  simpa [RawP8Strategy.familyAt] using hbad

/-- A wrong fanout tag cannot pass even at a bad `gamma`; fanout is deterministic. -/
theorem wrongComputeFanout_rejected
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.compRows)
    (hne : computeActualFanoutTag (computeTopologyNodeAt R i) ≠
      computeExpectedFanoutTag (computeTopologyNodeAt R i)) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  exact hne (computeFieldChecks_of_rowsVanish R A.compute hv.1 i).1

/-- Memory analogue of the deterministic fanout-mutation regression. -/
theorem wrongMemoryFanout_rejected
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.memRows)
    (hne : memoryActualFanoutTag (memoryTopologyNodeAt R i) ≠
      memoryExpectedFanoutTag (memoryTopologyNodeAt R i)) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  exact hne (memoryFieldChecks_of_rowsVanish R A.memory hv.2 i).1

/-- Any extra or missing compute child is rejected once bounded tags are interpreted through the
public characteristic hypothesis. -/
theorem extraOrMissingComputeChild_rejected
    (hchar : NodeEncoding.StateTagChar K)
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.compRows)
    (hne : ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1 ≠
      (computeTopologyNodeAt R i).children.length) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  have htag := (computeFieldChecks_of_rowsVanish R A.compute hv.1 i).1
  exact hne (computeFanout_eq_of_tag_eq hchar _ htag)

/-- Any extra or missing memory child is rejected under the same bounded-tag hypothesis. -/
theorem extraOrMissingMemoryChild_rejected
    (hchar : NodeEncoding.StateTagChar K)
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.memRows)
    (hne : MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1 ≠
      (memoryTopologyNodeAt R i).children.length) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  have htag := (memoryFieldChecks_of_rowsVanish R A.memory hv.2 i).1
  exact hne (memoryFanout_eq_of_tag_eq hchar _ htag)

/-- Active child-payload mutation is rejected by the deterministic lookup binding, independently
of the RLC collision event. -/
theorem mutatedComputeChildPayload_rejected
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.compRows) (slot : Fin 3)
    (hi : (slot : ℕ) <
      ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1)
    (hne : A.compute.childPayload i slot ≠ computeLookupPayload R i slot) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  have hs := (computeFieldChecks_of_rowsVanish R A.compute hv.1 i).2 slot hi
  exact hne (ComputeLinkPayload.encode_injective (funext hs.1))

theorem mutatedMemoryChildPayload_rejected
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R)
    (i : Fin R.cfg.memRows) (slot : Fin 2)
    (hi : (slot : ℕ) <
      MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1)
    (hne : A.memory.childPayload i slot ≠ memoryLookupPayload R i slot) :
    ¬ VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R A := by
  intro hsat
  have hv := (verifierGeneratedTopologyRAP_iff_rowsVanish R A).1 hsat
  have hs := (memoryFieldChecks_of_rowsVanish R A.memory hv.2 i).2 slot hi
  exact hne (MemoryLinkPayload.encode_injective (funext hs.1))



/-!
Only row constraints are needed in this architecture.  The verifier enumerates exactly
`Fin compRows` / `Fin memRows`, derives every active-prefix bit from the committed state fanout,
and performs direct authoritative forest reads.  There is no prover permutation accumulator, so
boundary, transition, and terminal segments are intentionally empty.
-/

namespace RawTopologyAIR

theorem compute_segment_counts :
    (kindSeg computeAIR .row).constraints.length = 34 ∧
      (kindSeg computeAIR .boundary).constraints.length = 0 ∧
      (kindSeg computeAIR .transition).constraints.length = 0 ∧
      (kindSeg computeAIR .terminal).constraints.length = 0 := by
  decide

theorem memory_segment_counts :
    (kindSeg memoryAIR .row).constraints.length = 15 ∧
      (kindSeg memoryAIR .boundary).constraints.length = 0 ∧
      (kindSeg memoryAIR .transition).constraints.length = 0 ∧
      (kindSeg memoryAIR .terminal).constraints.length = 0 := by
  decide

theorem segment_max_degrees :
    (kindSeg computeAIR .row).maxDegree = 2 ∧
      (kindSeg memoryAIR .row).maxDegree = 2 ∧
      (kindSeg computeAIR .boundary).maxDegree = 0 ∧
      (kindSeg computeAIR .transition).maxDegree = 0 ∧
      (kindSeg computeAIR .terminal).maxDegree = 0 ∧
      (kindSeg memoryAIR .boundary).maxDegree = 0 ∧
      (kindSeg memoryAIR .transition).maxDegree = 0 ∧
      (kindSeg memoryAIR .terminal).maxDegree = 0 := by
  decide

end RawTopologyAIR

/-- The lookup binding is deterministic, so the AIR adds zero random-collision workload.  The only
bad event remains the exact `gamma` RLC event already counted by `topologyWorkload`. -/
theorem topologyAIR_random_workload
    (R : RawPlusIOSegmentedFamily F K) :
    topologyWorkload R =
      R.cfg.compRows * 3 * 8 + R.cfg.memRows * 2 * 4 := rfl

/-- Deterministic verifier-side authoritative child-row reads.  This is work, not a prover lookup
argument: the verifier materializes up to three/two forest-first slots per committed parent row. -/
def topologyVerifierAuthoritativeLookupReads
    (R : RawPlusIOSegmentedFamily F K) : ℕ :=
  R.cfg.compRows * 3 + R.cfg.memRows * 2

theorem topologyVerifierAuthoritativeLookupReads_eq
    (R : RawPlusIOSegmentedFamily F K) :
    topologyVerifierAuthoritativeLookupReads R =
      R.cfg.compRows * 3 + R.cfg.memRows * 2 := rfl

/-- Total verifier-generated field cells before interpolation.  This makes the deterministic
classification explicit: no prover-supplied topology polynomial is parsed or authenticated. -/
def topologyVerifierGeneratedFieldCells
    (R : RawPlusIOSegmentedFamily F K) : ℕ :=
  R.cfg.compRows * RawTopologyAIR.computeTraceWidth +
    R.cfg.memRows * RawTopologyAIR.memoryTraceWidth

theorem topologyVerifierGeneratedFieldCells_eq
    (R : RawPlusIOSegmentedFamily F K) :
    topologyVerifierGeneratedFieldCells R =
      R.cfg.compRows * 86 + R.cfg.memRows * 34 := rfl


theorem topologyTrace_phase_separation
    (R : RawPlusIOSegmentedFamily F K) (A : RawTopologyArrays R) :
    (computeTopologyTrace R A.compute =
      encodeEnvTrace (computeTopologyRowEnv R A.compute) R.cfg.compNodes) ∧
    (memoryTopologyTrace R A.memory =
      encodeEnvTrace (memoryTopologyRowEnv R A.memory) R.cfg.memNodes) ∧
    topologyChallengeValuation R.walkGamma 0 = R.walkGamma := by
  exact ⟨rfl, rfl, rfl⟩

end

end Nock.NockVMROM.Thm54

