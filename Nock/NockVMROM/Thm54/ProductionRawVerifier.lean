import Nock.NockVMROM.Thm54.RawTopologyAIR
import Nock.NockVMROM.Thm54.TemplateRawJointSoundness

/-!
# Production raw verifier

This module is the acyclic assembly point for `RawVerifier`, `RawTopologyAIR`, and the staged
template strategy.  It imports both completed layers; neither lower layer imports this file.

Production prover messages are data only.  They contain topology child-index/payload arrays, never
topology trace polynomials.  The verifier deterministically constructs both topology traces from
those phase-committed arrays and the authoritative BFS rows.  Acceptance contains the existing
deterministic raw gates and exactly eight kind-segmented families: the original six plus these two
verifier-generated topology checks.  Since `ConstraintKind` has four constructors, this is exactly
32 segmented evaluations.

The topology arrays are dimensioned by dependent `Fin` domains.  The topology AIRs each use one
challenge (`walkGamma`, already bound to sampled `gamma` by `RawMessage.VerifierGates`), no public
columns, and only row constraints, so there are no additional topology endpoint gates.

This is deliberately not advertised as an authenticated arbitrary-trace RAP: absent a future
cross-table polynomial-commitment layer, constructing the topology trace is `O(compRows + memRows)`
verifier work.
-/

namespace Nock.NockVMROM.Thm54

open Classical
open Nock Framework Framework.Reify Framework.Thm54
open Nock.Reified
open scoped Polynomial

noncomputable section

variable {F K : Type} [Field F] [Field K] [Algebra F K]
variable {p : ℕ} [CharP K p]

namespace ProductionRawVerifier

/-! ## Data-only production message and acceptance -/

/-- The production message combines the existing raw message with pre-`gamma` topology arrays.
There are no topology trace fields, `Prop` fields, or topology, `RVT`, `Fcomp`, or `Fmem`
witnesses. -/
structure Message (R : RawPlusIOSegmentedFamily F K) (p : ℕ) where
  raw : RawMessage R p
  topology : RawTopologyArrays R

namespace Message

variable {R : RawPlusIOSegmentedFamily F K}

/-- Honest name for the two topology checks.  The trace arguments are not prover messages:
`computeTopologyTrace` and `memoryTopologyTrace` are deterministically generated by the verifier
from the committed child arrays and authoritative BFS rows. -/
def VerifierGeneratedSegmentedTopologyChecks (M : Message R p) : Prop :=
  (∀ kind, (computeTopologyGenericRAP R kind).Satisfies
      (computeTopologyTrace R M.topology.compute)) ∧
    (∀ kind, (memoryTopologyGenericRAP R kind).Satisfies
      (memoryTopologyTrace R M.topology.memory))

/-- The eight named kind-segmented RAP families checked by the production verifier. -/
def EightRAPSatisfy (M : Message R p) : Prop :=
  M.raw.SixRAPSatisfy ∧ M.VerifierGeneratedSegmentedTopologyChecks

/-- Stateless verifier evaluation of one assembled message.  This is intentionally not called
`Accepts`: by itself it cannot authenticate when `M.topology` was chosen.  Protocol acceptance is
exposed only by the phase-indexed strategy adapters below. -/
def VerifierChecks (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K) : Prop :=
  M.raw.VerifierGates claim ω ∧ M.EightRAPSatisfy

/-- Fully expanded verifier evaluation.  The eight displayed quantifiers range over the four
constructors of `ConstraintKind`, hence this statement names exactly 8 × 4 = 32 evaluations. -/
theorem verifierChecks_iff_eight_segmented_families
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K) :
    M.VerifierChecks claim ω ↔
      M.raw.VerifierGates claim ω ∧
      (∀ kind, (R.computeTableRAP kind).Satisfies M.raw.computeTableTrace) ∧
      (∀ kind, (R.memoryTableRAP kind).Satisfies M.raw.memoryTableTrace) ∧
      (∀ kind, (R.computeWalkRAP kind).Satisfies M.raw.computeWalkTrace) ∧
      (∀ kind, (R.memoryWalkRAP kind).Satisfies M.raw.memoryWalkTrace) ∧
      (∀ kind, (R.computeIORAP kind).Satisfies M.raw.computeIOTrace) ∧
      (∀ kind, (R.memoryIORAP kind).Satisfies M.raw.memoryIOTrace) ∧
      (∀ kind, (computeTopologyGenericRAP R kind).Satisfies
        (computeTopologyTrace R M.topology.compute)) ∧
      (∀ kind, (memoryTopologyGenericRAP R kind).Satisfies
        (memoryTopologyTrace R M.topology.memory)) :=
  by
    simp only [VerifierChecks, EightRAPSatisfy, RawMessage.SixRAPSatisfy,
      VerifierGeneratedSegmentedTopologyChecks]
    tauto

/-- Numerical receipt for the preceding exact expansion. -/
theorem segmented_evaluation_count : 8 * 4 = 32 := by decide

/-- Schema receipt: dependent array types supply row/slot dimensions; topology needs one sampled
challenge and no public endpoint columns. -/
theorem topology_interface_shape :
    RawTopologyAIR.computeAIR.numTraceCols = 86 ∧
      RawTopologyAIR.memoryAIR.numTraceCols = 34 ∧
      RawTopologyAIR.computeAIR.numChallenges = 1 ∧
      RawTopologyAIR.memoryAIR.numChallenges = 1 ∧
      RawTopologyAIR.computeAIR.numPublic = 0 ∧
      RawTopologyAIR.memoryAIR.numPublic = 0 ∧
      RawTopologyAIR.computeAIR.constraints.all (fun c => c.kind == .row) = true ∧
      RawTopologyAIR.memoryAIR.constraints.all (fun c => c.kind == .row) = true := by
  exact ⟨RawTopologyAIR.computeAIR_numTraceCols,
    RawTopologyAIR.memoryAIR_numTraceCols, rfl, rfl, rfl, rfl,
    RawTopologyAIR.computeAIR_all_row, RawTopologyAIR.memoryAIR_all_row⟩

/-- Projection to the original six segmented families. -/
theorem sixRAPSatisfy_of_verifierChecks
    {M : Message R p} {claim : P8PublicClaim} {ω : JointCoins K}
    (h : M.VerifierChecks claim ω) :
    M.raw.SixRAPSatisfy :=
  h.2.1

/-- Projection to the two honestly named verifier-generated topology checks. -/
theorem verifierGeneratedTopologyChecks_of_verifierChecks
    {M : Message R p} {claim : P8PublicClaim} {ω : JointCoins K}
    (h : M.VerifierChecks claim ω) :
    M.VerifierGeneratedSegmentedTopologyChecks :=
  h.2.2

/-- Internal bridge to the lower-layer spelling.  This does not expose arbitrary trace data:
both traces remain verifier-generated functions. -/
theorem verifierGeneratedTopologyRAPSatisfy_of_verifierChecks
    {M : Message R p} {claim : P8PublicClaim} {ω : JointCoins K}
    (h : M.VerifierChecks claim ω) :
    VerifierGeneratedTopologyRAPSatisfyOfCommittedArrays R M.topology := by
  exact verifierGeneratedTopologyChecks_of_verifierChecks h

/-- Passing the stateless checks retains the complete original raw verifier acceptance. -/
theorem rawAccepts_of_verifierChecks
    {M : Message R p} {claim : P8PublicClaim} {ω : JointCoins K}
    (h : M.VerifierChecks claim ω) :
    M.raw.Accepts claim ω :=
  ⟨h.1, sixRAPSatisfy_of_verifierChecks h⟩

/-- The shared topology challenge is the sampled `gamma`; this is inherited from the original
deterministic verifier gate rather than accepted as prover data. -/
theorem sampledGamma_of_verifierChecks
    {M : Message R p} {claim : P8PublicClaim} {ω : JointCoins K}
    (h : M.VerifierChecks claim ω) :
    R.walkGamma = gamma ω :=
  h.1.2.2.2.1

/-! ## Original raw forward soundness -/

theorem computeTable_sound_wfFree
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hchar : NodeEncoding.StateTagChar K) (h : M.VerifierChecks claim ω) :
    ((∀ i, ComputeTable.Vcomp R.cfg.challenges.computeInputs
        (R.exec.computePubAt i) (R.exec.computeDecAt i)) ∧
      ∀ i : Fin R.cfg.compRows, ∀ hi : (i : ℕ) + 1 < R.cfg.compRows,
        (R.exec.computePubAt i).ln =
          (R.exec.computePubAt ⟨(i : ℕ) + 1, hi⟩).ln_prev) ∧
      R.cfg.challenges.z ≠ 0 :=
  M.raw.computeTable_sound_wfFree hchar (sixRAPSatisfy_of_verifierChecks h).1

theorem memoryTable_sound_wfFree
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, (R.exec.memoryPubAt i).lambda = R.cfg.challenges.lam)
    (h : M.VerifierChecks claim ω) :
    ((∀ i, MemoryTable.Vmem R.cfg.challenges.memoryInputs
        (R.exec.memoryPubAt i)) ∧
      (∀ i : Fin R.cfg.memRows, ∀ hi : (i : ℕ) + 1 < R.cfg.memRows,
        (R.exec.memoryPubAt i).icur =
          (R.exec.memoryPubAt ⟨(i : ℕ) + 1, hi⟩).ipre) ∧
      (R.exec.memoryPubAt ⟨0, R.cfg.memRows_pos⟩).pt.counts = 0 ∧
      (R.exec.memoryPubAt ⟨0, R.cfg.memRows_pos⟩).pt.indicator = 0 ∧
      (R.exec.memoryPubAt ⟨0, R.cfg.memRows_pos⟩).ipre = 0 ∧
      (R.exec.memoryPubAt
        (R.cfg.orbit.lastIndex R.cfg.memRows R.cfg.memRows_pos)).icur = 0) ∧
      R.cfg.challenges.z ≠ 0 :=
  M.raw.memoryTable_sound_wfFree hchar hlam (sixRAPSatisfy_of_verifierChecks h).2.1

theorem computeWalk_sound
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (h : M.VerifierChecks claim ω) :
    M.raw.ComputeWalkCertificate :=
  M.raw.computeWalkRAP_wholeTrace_iff.mp
    (sixRAPSatisfy_of_verifierChecks h).2.2.1

theorem memoryWalk_sound
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (h : M.VerifierChecks claim ω) :
    M.raw.MemoryWalkCertificate :=
  M.raw.memoryWalkRAP_wholeTrace_iff.mp
    (sixRAPSatisfy_of_verifierChecks h).2.2.2.1

theorem io_sound
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hKp : R.cfg.Ksz < p)
    (hProgCap : R.exec.derivedRequestIO.length + 1 ≤ 2 ^ R.cfg.orbit.h)
    (hMemCap : R.exec.derivedResponseIO.length + 1 ≤ 2 ^ R.cfg.orbit.h)
    (h : M.VerifierChecks claim ω) :
    IO.LIO R.cfg.Ksz R.exec.derivedRequestIO R.exec.derivedResponseIO :=
  M.raw.lio_of_accepts hKp hProgCap hMemCap (rawAccepts_of_verifierChecks h)

/-! ## Topology soundness and the counted collision event -/

/-- The
compressed check is not part of production acceptance. -/
theorem topologyCompressedCheck_of_accepts
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hchar : NodeEncoding.StateTagChar K) (h : M.VerifierChecks claim ω) :
    TopologyCompressedCheck R (gamma ω) := by
  have hcheck :=
    topologyCompressedCheck_of_verifierGeneratedRAPOfCommittedArrays
      hchar R M.topology
    (verifierGeneratedTopologyRAPSatisfy_of_verifierChecks h)
  rw [← sampledGamma_of_verifierChecks h]
  exact hcheck

/-- Exact compute and memory topology outside the already-counted sampled-`gamma` collision event. -/
theorem exactTopology_of_accepts
    [Fintype K] [DecidableEq K]
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, (R.exec.memoryPubAt i).lambda = R.cfg.challenges.lam)
    (h : M.VerifierChecks claim ω)
    (hout : gamma ω ∉ topologyBadGammas R) :
    ComputeExactTopology R.exec ∧ MemoryExactTopology R.exec :=
  M.raw.exactTopology_of_accepts_and_verifierGeneratedTopologyRAPOfCommittedArrays
    M.topology hchar hlam
    (rawAccepts_of_verifierChecks h)
    (verifierGeneratedTopologyRAPSatisfy_of_verifierChecks h) hout

theorem topology_collision_event_card_le
    [Fintype K] [DecidableEq K] (R : RawPlusIOSegmentedFamily F K) :
    (topologyBadGammas R).card ≤ topologyWorkload R :=
  topologyBadGammas_card_le R

/-! ## Honest completeness -/

/-- Add the canonical honest topology arrays to any existing raw message. -/
def withHonestTopology (M : RawMessage R p) : Message R p where
  raw := M
  topology := honestTopologyArrays R

/-- Completeness cleanly separates the existing honest raw-assignment premise from the
completeness-only exact-topology premise used to construct honest topology arrays. -/
theorem accepts_withHonestTopology
    (M : RawMessage R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hraw : M.Accepts claim ω)
    (htop : ComputeExactTopology R.exec ∧ MemoryExactTopology R.exec) :
    (withHonestTopology M).VerifierChecks claim ω := by
  have htopRAP := honestVerifierGeneratedTopologyRAP_complete R htop
  exact ⟨hraw.1, hraw.2, htopRAP⟩

/-- Honest production message obtained from an existing exact segmented assignment. -/
def ofLegacy {S : PlusIOSegmentedFamily F K}
    (A : PlusIOSameExecutionAssignment S p) :
    Message (RawPlusIOSegmentedFamily.ofLegacy S) p :=
  withHonestTopology (RawMessage.ofLegacy A)

/-- Existing exact assignment satisfaction supplies the original six families.  Exact topology is
an explicit completeness-only premise and supplies only the two new topology families. -/
theorem accepts_of_legacy_assignment
    {S : PlusIOSegmentedFamily F K}
    (A : PlusIOSameExecutionAssignment S p)
    (claim : P8PublicClaim) (ω : JointCoins K)
    (hA : A.Satisfies)
    (hgates : (RawMessage.ofLegacy A).VerifierGates claim ω)
    (htop :
      ComputeExactTopology (RawPlusIOSegmentedFamily.ofLegacy S).exec ∧
        MemoryExactTopology (RawPlusIOSegmentedFamily.ofLegacy S).exec) :
    (ofLegacy A).VerifierChecks claim ω := by
  apply accepts_withHonestTopology (RawMessage.ofLegacy A) claim ω
  · exact RawMessage.accepts_of_legacy_assignment claim ω A hA hgates
  · exact htop

/-! ## Negative gates and mutation rejection -/

/-- Every original negative verifier gate remains necessary. -/
theorem not_accepts_of_not_verifierGates
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hgate : ¬ M.raw.VerifierGates claim ω) :
    ¬ M.VerifierChecks claim ω :=
  fun h => hgate h.1

/-- In particular, the zero-seed negative gate is unchanged. -/
theorem zeroSeed_rejected
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (hz : nprSeed ω = 0) :
    ¬ M.VerifierChecks claim ω := by
  intro h
  exact h.1.1 (by simp [hz])

/-- Deterministic fanout failures remain rejecting independently of the gamma event. -/
theorem wrongComputeFanout_rejected
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (i : Fin R.cfg.compRows)
    (hne : computeActualFanoutTag (computeTopologyNodeAt R i) ≠
      computeExpectedFanoutTag (computeTopologyNodeAt R i)) :
    ¬ M.VerifierChecks claim ω := by
  intro h
  exact Nock.NockVMROM.Thm54.wrongComputeFanout_rejected R M.topology i hne
    (verifierGeneratedTopologyRAPSatisfy_of_verifierChecks h)

/-- Active compute payload mutations cannot pass the deterministic lookup binding. -/
theorem mutatedComputeChildPayload_rejected
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (i : Fin R.cfg.compRows) (slot : Fin 3)
    (hi : (slot : ℕ) <
      ComputeTable.fanoutComp (computeTopologyNodeAt R i).label.1)
    (hne : M.topology.compute.childPayload i slot ≠ computeLookupPayload R i slot) :
    ¬ M.VerifierChecks claim ω := by
  intro h
  exact Nock.NockVMROM.Thm54.mutatedComputeChildPayload_rejected
    R M.topology i slot hi hne
      (verifierGeneratedTopologyRAPSatisfy_of_verifierChecks h)

/-- Active memory payload mutations cannot pass the deterministic lookup binding. -/
theorem mutatedMemoryChildPayload_rejected
    (M : Message R p) (claim : P8PublicClaim) (ω : JointCoins K)
    (i : Fin R.cfg.memRows) (slot : Fin 2)
    (hi : (slot : ℕ) <
      MemoryTable.fanoutMem (memoryTopologyNodeAt R i).label.1)
    (hne : M.topology.memory.childPayload i slot ≠ memoryLookupPayload R i slot) :
    ¬ M.VerifierChecks claim ω := by
  intro h
  exact Nock.NockVMROM.Thm54.mutatedMemoryChildPayload_rejected
    R M.topology i slot hi hne
      (verifierGeneratedTopologyRAPSatisfy_of_verifierChecks h)

end Message

/-! ## Seed-fixed raw strategy adapter -/

namespace SeedAdapter

/-- Old raw chronology with topology child arrays added to the seed commitment.  The only
full-coin response remains the wrapped strategy's `RawWalkArrays`; no function in this structure
can choose topology arrays after seeing `omega`. -/
structure Strategy (F K : Type) [Field F] [Field K] [Algebra F K]
    (p : ℕ) [CharP K p] where
  raw : RawP8Strategy F K p
  topologyAfterSeed :
    ∀ (z : K) (hz : z ≠ 0),
      RawTopologySeedArrays (raw.afterSeed z hz)

namespace Strategy

def familyAt (T : Strategy F K p)
    (ω : JointCoins K) (hz : nprSeed ω ≠ 0) :
    RawPlusIOSegmentedFamily F K :=
  T.raw.familyAt ω hz

/-- Reinterpret the already seed-committed arrays at the sampled family. -/
def topologyAt (T : Strategy F K p)
    (ω : JointCoins K) (hz : nprSeed ω ≠ 0) :
    RawTopologyArrays (T.familyAt ω hz) :=
  (T.topologyAfterSeed (nprSeed ω) hz).atJointCoins ω

def messageAt (T : Strategy F K p)
    (ω : JointCoins K) (hz : nprSeed ω ≠ 0) :
    Message (T.familyAt ω hz) p where
  raw := T.raw.messageAt ω hz
  topology := T.topologyAt ω hz

/-- Seed-fixed production acceptance evaluates only verifier-generated topology traces. -/
def Accepts (T : Strategy F K p) (ω : JointCoins K) : Prop :=
  if hz : nprSeed ω ≠ 0 then
    (T.messageAt ω hz).VerifierChecks T.raw.claim ω
  else False

theorem accepts_iff_production
    (T : Strategy F K p) (ω : JointCoins K) (hz : nprSeed ω ≠ 0) :
    T.Accepts ω ↔ (T.messageAt ω hz).VerifierChecks T.raw.claim ω := by
  simp [Accepts, hz]

/-- Exact seed-fixed acceptance expansion into all eight named families (32 evaluations). -/
theorem accepts_iff_eight_segmented_families
    (T : Strategy F K p) (ω : JointCoins K) (hz : nprSeed ω ≠ 0) :
    T.Accepts ω ↔
      (T.messageAt ω hz).raw.VerifierGates T.raw.claim ω ∧
      (∀ kind, ((T.familyAt ω hz).computeTableRAP kind).Satisfies
        (T.messageAt ω hz).raw.computeTableTrace) ∧
      (∀ kind, ((T.familyAt ω hz).memoryTableRAP kind).Satisfies
        (T.messageAt ω hz).raw.memoryTableTrace) ∧
      (∀ kind, ((T.familyAt ω hz).computeWalkRAP kind).Satisfies
        (T.messageAt ω hz).raw.computeWalkTrace) ∧
      (∀ kind, ((T.familyAt ω hz).memoryWalkRAP kind).Satisfies
        (T.messageAt ω hz).raw.memoryWalkTrace) ∧
      (∀ kind, ((T.familyAt ω hz).computeIORAP kind).Satisfies
        (T.messageAt ω hz).raw.computeIOTrace) ∧
      (∀ kind, ((T.familyAt ω hz).memoryIORAP kind).Satisfies
        (T.messageAt ω hz).raw.memoryIOTrace) ∧
      (∀ kind, (computeTopologyGenericRAP (T.familyAt ω hz) kind).Satisfies
        (computeTopologyTrace (T.familyAt ω hz)
          (T.messageAt ω hz).topology.compute)) ∧
      (∀ kind, (memoryTopologyGenericRAP (T.familyAt ω hz) kind).Satisfies
        (memoryTopologyTrace (T.familyAt ω hz)
          (T.messageAt ω hz).topology.memory)) := by
  rw [T.accepts_iff_production ω hz]
  exact Message.verifierChecks_iff_eight_segmented_families _ _ _

theorem rawAccepts_of_accepts
    (T : Strategy F K p) (ω : JointCoins K) (hz : nprSeed ω ≠ 0)
    (h : T.Accepts ω) :
    T.raw.Accepts ω := by
  have hp := (T.accepts_iff_production ω hz).1 h
  apply (show T.raw.Accepts ω from ?_)
  simp only [RawP8Strategy.Accepts, dif_pos hz]
  exact Message.rawAccepts_of_verifierChecks hp

theorem forwardSoundness_of_accepts
    (T : Strategy F K p) (ω : JointCoins K) (hz : nprSeed ω ≠ 0)
    (hchar : NodeEncoding.StateTagChar K)
    (hKp : (T.familyAt ω hz).cfg.Ksz < p)
    (hProgCap :
      (T.familyAt ω hz).exec.derivedRequestIO.length + 1 ≤
        2 ^ (T.familyAt ω hz).cfg.orbit.h)
    (hMemCap :
      (T.familyAt ω hz).exec.derivedResponseIO.length + 1 ≤
        2 ^ (T.familyAt ω hz).cfg.orbit.h)
    (hlam : ∀ i, ((T.familyAt ω hz).exec.memoryPubAt i).lambda = (T.familyAt ω hz).cfg.challenges.lam)
    (h : T.Accepts ω) :
    T.raw.ForwardSoundnessAt ω hz := by
  let M := T.messageAt ω hz
  have hp : M.VerifierChecks T.raw.claim ω :=
    (T.accepts_iff_production ω hz).1 h
  have hcomp := Message.computeTable_sound_wfFree M T.raw.claim ω hchar hp
  have hmem := Message.memoryTable_sound_wfFree M T.raw.claim ω hchar hlam hp
  exact
    { computeTable := hcomp.1
      memoryTable := hmem.1
      seedNonzero := hcomp.2
      computeWalk := Message.computeWalk_sound M T.raw.claim ω hp
      memoryWalk := Message.memoryWalk_sound M T.raw.claim ω hp
      exactIO := Message.io_sound M T.raw.claim ω hKp hProgCap hMemCap hp }

/-- Exact topology follows from the seed-committed verifier-generated checks outside the existing
seed-fibered gamma event. -/
theorem exactTopology_of_accepts
    [Fintype K] [DecidableEq K]
    (T : Strategy F K p) (ω : JointCoins K) (hz : nprSeed ω ≠ 0)
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, ((T.familyAt ω hz).exec.memoryPubAt i).lambda = (T.familyAt ω hz).cfg.challenges.lam)
    (h : T.Accepts ω)
    (hout : ω ∉ rawStrategyTopologyFailureEvent T.raw) :
    ComputeExactTopology (T.familyAt ω hz).exec ∧
      MemoryExactTopology (T.familyAt ω hz).exec := by
  have hp := (T.accepts_iff_production ω hz).1 h
  apply Message.exactTopology_of_accepts
    (T.messageAt ω hz) T.raw.claim ω hchar hlam hp
  intro hbad
  apply hout
  apply (mem_rawStrategyTopologyFailureEvent_iff T.raw ω).2
  refine ⟨hz, ?_⟩
  change gamma ω ∈
    topologyBadGammas (T.raw.afterSeed (nprSeed ω) hz).base at hbad
  exact hbad

end Strategy

end SeedAdapter

/-! ## Template-fixed staged adapter -/

namespace TemplateAdapter

open TemplateRawJointSoundness

/-- Transport topology arrays committed after `(z, alphaM)` to the final family.  Only the two
later scalar walk coordinates change; no sampled challenge is inserted into an array. -/
def topologyAtCoins
    {T : SemanticTimestampStrategy.DataOnlyTemplateFixedStagedTimestampStrategy
      (F := F) (K := K)}
    {z : K} {hz : z ≠ 0} {alphaMValue lmb : K}
    {C : AlphaMCommitment (p := p) T z hz alphaMValue lmb}
    (A : RawTopologyArrays C.familyData.base)
    (alphaCValue gammaValue : K) :
    RawTopologyArrays (C.familyData.atCoins alphaCValue gammaValue) where
  compute := ⟨A.compute.childPayload⟩
  memory := ⟨A.memory.childPayload⟩

/-- A template-fixed production strategy.  Topology arrays are committed at the existing
`(z, alphaM)` phase, before `alphaC` and `gamma`; the wrapped strategy still contributes only raw
walk arrays after all coins. -/
structure Strategy (F K : Type) [Field F] [Field K] [Algebra F K]
    (p : ℕ) [CharP K p] where
  raw : TemplateRawJointSoundness.Strategy F K p
  topologyAfterAlphaM :
    ∀ (z : K) (hz : z ≠ 0) (alphaMValue lmb : K),
      RawTopologyArrays
        (raw.afterAlphaM z hz alphaMValue lmb).familyData.base

namespace Strategy

def familyAt (T : Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    RawPlusIOSegmentedFamily F K :=
  T.raw.familyAt ω lmb hz

def topologyAt (T : Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    RawTopologyArrays (T.familyAt ω lmb hz) :=
  topologyAtCoins
    (T.topologyAfterAlphaM (nprSeed ω) hz (alphaM ω) lmb)
    (alphaC ω) (gamma ω)

/-- The final staged message is data-only: the wrapped `RawMessage` plus phase-correct topology
arrays. -/
def messageAt (T : Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    Message (T.familyAt ω lmb hz) p where
  raw := T.raw.messageAt ω lmb hz
  topology := T.topologyAt ω lmb hz

/-- Every memory row of the sampled family carries the sampled `λ` (template specialization;
`TemplateRawJointSoundness.Strategy.familyAt_memoryLambda`). -/
theorem familyAt_memoryLambda (T : Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (i : Fin (T.familyAt ω lmb hz).cfg.memRows) :
    ((T.familyAt ω lmb hz).exec.memoryPubAt i).lambda =
      (T.familyAt ω lmb hz).cfg.challenges.lam :=
  T.raw.familyAt_memoryLambda ω lmb hz i

/-- Final staged acceptance uses the production eight-family verifier.  This is the replacement
for the old `TemplateRawJointSoundness.Strategy.AcceptsWithTopology`, which directly assumed
`TopologyCompressedCheck`. -/
def Accepts (T : Strategy F K p) (ω : JointCoins K) (lmb : K) : Prop :=
  if hz : nprSeed ω ≠ 0 then
    (T.messageAt ω lmb hz).VerifierChecks T.raw.claim ω
  else False

theorem accepts_iff_production
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    T.Accepts ω lmb ↔
      (T.messageAt ω lmb hz).VerifierChecks T.raw.claim ω := by
  simp [Accepts, hz]

/-- Exact expansion of final staged acceptance into all eight named families (32 evaluations). -/
theorem accepts_iff_eight_segmented_families
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    T.Accepts ω lmb ↔
      (T.messageAt ω lmb hz).raw.VerifierGates T.raw.claim ω ∧
      (∀ kind, ((T.familyAt ω lmb hz).computeTableRAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.computeTableTrace) ∧
      (∀ kind, ((T.familyAt ω lmb hz).memoryTableRAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.memoryTableTrace) ∧
      (∀ kind, ((T.familyAt ω lmb hz).computeWalkRAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.computeWalkTrace) ∧
      (∀ kind, ((T.familyAt ω lmb hz).memoryWalkRAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.memoryWalkTrace) ∧
      (∀ kind, ((T.familyAt ω lmb hz).computeIORAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.computeIOTrace) ∧
      (∀ kind, ((T.familyAt ω lmb hz).memoryIORAP kind).Satisfies
        (T.messageAt ω lmb hz).raw.memoryIOTrace) ∧
      (∀ kind, (computeTopologyGenericRAP (T.familyAt ω lmb hz) kind).Satisfies
        (computeTopologyTrace (T.familyAt ω lmb hz)
          (T.messageAt ω lmb hz).topology.compute)) ∧
      (∀ kind, (memoryTopologyGenericRAP (T.familyAt ω lmb hz) kind).Satisfies
        (memoryTopologyTrace (T.familyAt ω lmb hz)
          (T.messageAt ω lmb hz).topology.memory)) := by
  rw [T.accepts_iff_production ω lmb hz]
  exact Message.verifierChecks_iff_eight_segmented_families _ _ _

/-- Production acceptance projects to the wrapped staged strategy's original six-family
acceptance, preserving every existing forward-soundness theorem. -/
theorem rawAccepts_of_accepts
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (h : T.Accepts ω lmb) :
    T.raw.Accepts ω lmb := by
  have hp := (T.accepts_iff_production ω lmb hz).1 h
  apply (T.raw.accepts_iff_raw ω lmb hz).2
  exact Message.rawAccepts_of_verifierChecks hp

theorem forwardSoundness_of_accepts
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (hchar : NodeEncoding.StateTagChar K)
    (hKp : (T.familyAt ω lmb hz).cfg.Ksz < p)
    (hProgCap :
      (T.familyAt ω lmb hz).exec.derivedRequestIO.length + 1 ≤
        2 ^ (T.familyAt ω lmb hz).cfg.orbit.h)
    (hMemCap :
      (T.familyAt ω lmb hz).exec.derivedResponseIO.length + 1 ≤
        2 ^ (T.familyAt ω lmb hz).cfg.orbit.h)
    (hlam : ∀ i, ((T.raw.familyAt ω lmb hz).exec.memoryPubAt i).lambda = (T.raw.familyAt ω lmb hz).cfg.challenges.lam)
    (h : T.Accepts ω lmb) :
    T.raw.ForwardSoundnessAt ω lmb hz :=
  T.raw.forwardSoundness_of_accepts ω lmb hz hchar hKp hProgCap hMemCap hlam
    (T.rawAccepts_of_accepts ω lmb hz h)

/-- The former direct compressed-check acceptance follows from production acceptance as a derived
compatibility theorem, not as a verifier premise. -/
theorem acceptsWithTopology_of_accepts
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (hchar : NodeEncoding.StateTagChar K)
    (h : T.Accepts ω lmb) :
    T.raw.AcceptsWithTopology ω lmb := by
  have hp := (T.accepts_iff_production ω lmb hz).1 h
  have hraw := T.rawAccepts_of_accepts ω lmb hz h
  have hcheck := Message.topologyCompressedCheck_of_accepts
    (T.messageAt ω lmb hz) T.raw.claim ω hchar hp
  rw [TemplateRawJointSoundness.Strategy.AcceptsWithTopology, dif_pos hz]
  constructor
  · exact (T.raw.accepts_iff_raw ω lmb hz).1 hraw
  · exact hcheck

/-- Direct production topology soundness outside the template strategy's counted gamma event. -/
theorem exactTopology_of_accepts
    [Fintype K] [DecidableEq K]
    (T : Strategy F K p) (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (hchar : NodeEncoding.StateTagChar K)
    (hlam : ∀ i, ((T.familyAt ω lmb hz).exec.memoryPubAt i).lambda = (T.familyAt ω lmb hz).cfg.challenges.lam)
    (h : T.Accepts ω lmb)
    (hout : ω ∉ specializedTopologyFailureEvent T.raw lmb) :
    ComputeExactTopology (T.familyAt ω lmb hz).exec ∧
      MemoryExactTopology (T.familyAt ω lmb hz).exec := by
  have hp := (T.accepts_iff_production ω lmb hz).1 h
  apply Message.exactTopology_of_accepts
    (T.messageAt ω lmb hz) T.raw.claim ω hchar hlam hp
  intro hbad
  apply hout
  apply (mem_specializedTopologyFailureEvent_iff T.raw lmb ω).2
  refine ⟨hz, ?_⟩
  change gamma ω ∈ topologyBadGammas
    (T.raw.afterAlphaM (nprSeed ω) hz (alphaM ω) lmb).familyData.base at hbad
  exact hbad

/-! ### Honest adapter and completeness -/

/-- Canonical adapter for an existing template strategy.  It commits the deterministic honest
topology arrays at `(z, alphaM)`; no exact-topology proof is stored in the strategy. -/
def honest (T : TemplateRawJointSoundness.Strategy F K p) :
    Strategy F K p where
  raw := T
  topologyAfterAlphaM := fun z hz alphaMValue lmb =>
    honestTopologyArrays (T.afterAlphaM z hz alphaMValue lmb).familyData.base

/-- The honest adapter's final production message is the wrapped raw message equipped with honest
topology arrays. -/
theorem honest_messageAt
    (T : TemplateRawJointSoundness.Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0) :
    (honest T).messageAt ω lmb hz =
      Message.withHonestTopology (T.messageAt ω lmb hz) := by
  congr 1

/-- Staged completeness: original template acceptance is the old honest-assignment premise;
exact topology is a separate completeness-only premise for the two topology AIRs. -/
theorem honest_accepts
    (T : TemplateRawJointSoundness.Strategy F K p)
    (ω : JointCoins K) (lmb : K) (hz : nprSeed ω ≠ 0)
    (hraw : T.Accepts ω lmb)
    (htop :
      ComputeExactTopology (T.familyAt ω lmb hz).exec ∧
        MemoryExactTopology (T.familyAt ω lmb hz).exec) :
    (honest T).Accepts ω lmb := by
  apply ((honest T).accepts_iff_production ω lmb hz).2
  rw [honest_messageAt]
  apply Message.accepts_withHonestTopology
  · exact (T.accepts_iff_raw ω lmb hz).1 hraw
  · exact htop

end Strategy

end TemplateAdapter

end ProductionRawVerifier

