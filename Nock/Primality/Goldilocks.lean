/-
  Nock/Primality/Goldilocks.lean

  In-kernel proofs, by Pratt /
  Lucas certificate (`Nock.Primality.Pratt`), that

  * `p = 2^64 - 2^32 + 1` is prime: `goldilocks_prime_thm : Nat.Prime Nock.Field.p`, the exact type
    of the axiom `Nock.Field.goldilocks_prime` (which is NOT touched here);
  * `p^2 + p + 1 = 3 * 937 * 724723 * 167034643597991036904547663171` with all four primes
    certified, hence `τ(p^3 - 1) = 12672`;
  * `τ(p^6 - 1) ≤ 2^200` (crude `τ(n) ≤ 2 √n`, no factorization needed; true value 835584).

  The certificate was generated by an external script; Lean re-checks every line.
-/
import Nock.Field
import Nock.Primality.Pratt
import Nock.Primality.GoldilocksCore
import Nock.NockVMROM.Thm54.TightWindow

set_option autoImplicit false

namespace Nock.Primality

open Nock.Field


/-- **`p = 2^64 - 2^32 + 1` is prime**, in the kernel, with the axiom's exact type. -/
theorem goldilocks_prime_thm : Nat.Prime Nock.Field.p := by
  have h : (18446744069414584321 : ℕ) ∈ goldilocksCert.map Entry.n := by decide +kernel
  have := cert_prime h
  rwa [← Nock.Field.p_eq] at this

/-- The factored form of `p^3 - 1` (`3` squared: `3 ∣ p - 1` and `3 ∣ p^2 + p + 1`). -/
def p3Fs : List (ℕ × ℕ) :=
  [(2, 32), (3, 2), (5, 1), (17, 1), (257, 1), (65537, 1), (937, 1), (724723, 1),
   (167034643597991036904547663171, 1)]

theorem p3Fs_prod : prodPow p3Fs = 18446744069414584321 ^ 3 - 1 := by decide +kernel

theorem p3Fs_nodup : (p3Fs.map Prod.fst).Nodup := by decide +kernel

theorem p3Fs_prime : ∀ x ∈ p3Fs, x.1.Prime := by
  intro x hx
  have hm : x.1 ∈ goldilocksCert.map Entry.n ∨ x.1 = 2 := by
    revert x; decide +kernel
  rcases hm with hm | h2
  · exact cert_prime hm
  · rw [h2]; exact Nat.prime_two

/-- **`τ(p^3 - 1) = 12672`** for `p = 2^64 - 2^32 + 1`. -/
theorem tau_p3_sub_one : ((Nock.Field.p) ^ 3 - 1).divisors.card = 12672 := by
  rw [Nock.Field.p_eq, ← p3Fs_prod, card_divisors_prodPow p3Fs p3Fs_prime p3Fs_nodup]
  decide +kernel

/-- **`τ(p^6 - 1) ≤ 2^200`** (crude; the true value is 835584). -/
theorem tau_p6_sub_one_le : ((Nock.Field.p) ^ 6 - 1).divisors.card ≤ 2 ^ 200 := by
  refine (card_divisors_le_two_mul_sqrt _).trans ?_
  have hp : Nock.Field.p < 2 ^ 64 := by rw [Nock.Field.p_eq]; norm_num
  have h6 : Nock.Field.p ^ 6 - 1 < (2 ^ 192) ^ 2 := by
    calc Nock.Field.p ^ 6 - 1 ≤ Nock.Field.p ^ 6 := Nat.sub_le _ _
      _ < (2 ^ 64) ^ 6 := Nat.pow_lt_pow_left hp (by norm_num)
      _ = (2 ^ 192) ^ 2 := by ring
  have := Nat.sqrt_lt'.mpr h6
  have h2 : 2 * Nat.sqrt (Nock.Field.p ^ 6 - 1) ≤ 2 * 2 ^ 192 := by omega
  calc _ ≤ 2 * 2 ^ 192 := h2
    _ ≤ 2 ^ 200 := by norm_num

end Nock.Primality

namespace Nock.NockVMROM.Thm54.TightWindow

/-- T1's `hτ` at `p³`, discharged: `hΛK` at `p³`, `Λ = 2^110`, no divisor hypothesis. -/
theorem hLambdaK3_goldilocks_hΛK_proved (R : ℕ) (hR : R ≤ 2 ^ 32) :
    hLambdaK pG 3 R (2 ^ 110) := by
  refine hLambdaK3_goldilocks_hΛK R hR ?_
  have h := Nock.Primality.tau_p3_sub_one
  have hpG : pG = Nock.Field.p := rfl
  rw [hpG]; exact h.le

/-- T1's `hτ` at `p⁶`, discharged. -/
theorem hLambdaK6_goldilocks_hΛK_proved (R : ℕ) (hR : R ≤ 2 ^ 32) :
    hLambdaK pG 6 R (2 ^ 110) := by
  refine hLambdaK6_goldilocks_hΛK R hR ?_
  have hpG : pG = Nock.Field.p := rfl
  rw [hpG]; exact Nock.Primality.tau_p6_sub_one_le

end Nock.NockVMROM.Thm54.TightWindow

namespace Nock.Primality

open Nock.Field

theorem seven_pow_half : powMod 7 (Nock.Field.p / 2) Nock.Field.p = Nock.Field.p - 1 := by
  rw [Nock.Field.p_eq]; decide +kernel

/-- **`7` is a non-square in `ZMod p`** (Euler's criterion: `7^((p-1)/2) ≡ -1`). -/
theorem seven_not_square_of_fact [Fact (Nat.Prime Nock.Field.p)] :
    ¬ IsSquare (7 : ZMod Nock.Field.p) := by
  have hp : Nock.Field.p = 18446744069414584321 := Nock.Field.p_eq
  have hlt : Nock.Field.p / 2 < 2 ^ 128 := by rw [hp]; norm_num
  have h1 : 7 ^ (Nock.Field.p / 2) % Nock.Field.p = Nock.Field.p - 1 := by
    rw [← powMod_eq hlt]; exact seven_pow_half
  have h7 : (7 : ZMod Nock.Field.p) ≠ 0 := by
    intro h
    have : ((7 : ℕ) : ZMod Nock.Field.p) = ((0 : ℕ) : ZMod Nock.Field.p) := by simpa using h
    rw [ZMod.natCast_eq_natCast_iff'] at this
    rw [hp] at this; norm_num at this
  rw [ZMod.euler_criterion Nock.Field.p h7]
  intro h
  have h2 : (((7 ^ (Nock.Field.p / 2) : ℕ)) : ZMod Nock.Field.p) = ((1 : ℕ) : ZMod Nock.Field.p) := by
    push_cast; exact h
  rw [ZMod.natCast_eq_natCast_iff', h1] at h2
  rw [hp] at h2; norm_num at h2

/-- **`7` is a non-square in `ZMod p`, stated with the `CommRing` structure only.**  The statement of
the `Fact`-instance form elaborates `7` and `*` through `ZMod.instField p Nock.Field.instFactPrimeP`, which
carries the axiom `Nock.Field.goldilocks_prime`.  Here the `CommRing` instance is passed explicitly, so
the statement mentions no `Field` instance; the proof supplies `Fact p.Prime` from `goldilocks_prime_thm`. -/
theorem seven_not_square :
    ¬ @IsSquare (ZMod Nock.Field.p) (ZMod.commRing Nock.Field.p).toMul
        (@OfNat.ofNat (ZMod Nock.Field.p) 7
          (@instOfNatAtLeastTwo (ZMod Nock.Field.p) 7 (ZMod.commRing Nock.Field.p).toNatCast
            inferInstance)) := by
  haveI : Fact (Nat.Prime Nock.Field.p) := ⟨goldilocks_prime_thm⟩
  exact seven_not_square_of_fact

end Nock.Primality
